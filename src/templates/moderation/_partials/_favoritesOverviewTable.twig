{% import 'engagement/moderation/_partials/_ui.twig' as h %}

<div class="tablepane">
<table class="data fullwidth">
  <thead>
    <tr>
      <th class="thin"></th>
      <th>{{ 'Entry'|t('engagement') }}</th>
      <th>{{ 'Field'|t('engagement') }}</th>
      <th>{{ 'Favorites'|t('engagement') }}</th>
      <th>{{ 'Element ID'|t('engagement') }}</th>
      <th>{{ 'Updated'|t('engagement') }}</th>
    </tr>
  </thead>
  <tbody>
    {% for aggregate in favorites %}
      <tr>
        <td><a class="eng-row-open" href="{{ cpUrl('engagement/moderation/favorites/' ~ aggregate.id) }}" title="{{ 'View aggregate details'|t('engagement') }}" aria-label="{{ 'View aggregate details'|t('engagement') }}">↗</a></td>
        <td>{{ h.entryLink(aggregate) }}</td>
        <td>{{ h.fieldLabel(aggregate) }}</td>
        <td>{{ aggregate.favoriteCount }}</td>
        <td>{{ aggregate.elementId }}</td>
        <td>{{ aggregate.dateUpdated|datetime('short') }}</td>
      </tr>
    {% else %}
      <tr><td colspan="6"><span class="light">{{ emptyMessage ?? 'No rows found.'|t('engagement') }}</span></td></tr>
    {% endfor %}
  </tbody>
</table>
</div>
