<form method="get" accept-charset="UTF-8" data-eng-auto-filter="1" class="eng-toolbar">
  <div class="eng-toolbar-search">
    <span class="eng-search-icon" aria-hidden="true">⌕</span>
    <input
      class="text fullwidth"
      type="text"
      id="q"
      name="q"
      value="{{ q ?? '' }}"
      placeholder="{{ 'Search'|t('engagement') }}"
      data-eng-auto-submit="1"
      data-eng-auto-submit-type="text"
      autocomplete="off"
    >
  </div>

  <div class="eng-toolbar-selects">
    <select id="sort" name="sort" data-eng-auto-submit="1">
      {% for option in sortOptions %}
        <option value="{{ option.value }}" {{ option.value == sort ? 'selected' : '' }}>{{ option.label }}</option>
      {% endfor %}
    </select>

    <select id="perPage" name="perPage" data-eng-auto-submit="1">
      {% for value in [25, 50, 100] %}
        <option value="{{ value }}" {{ value == perPage ? 'selected' : '' }}>{{ value }}</option>
      {% endfor %}
    </select>
  </div>

  <noscript>
    <button class="btn submit">{{ 'Apply'|t('engagement') }}</button>
  </noscript>
</form>

{% js %}
  (() => {
    const form = document.querySelector('form[data-eng-auto-filter="1"]');
    if (!form) {
      return;
    }

    const controls = form.querySelectorAll('select[data-eng-auto-submit="1"]');
    controls.forEach((control) => {
      control.addEventListener('change', () => {
        if (typeof form.requestSubmit === 'function') {
          form.requestSubmit();
        } else {
          form.submit();
        }
      });
    });

    const textControls = form.querySelectorAll('input[data-eng-auto-submit-type="text"]');
    textControls.forEach((control) => {
      let timeoutId;
      control.addEventListener('input', () => {
        window.clearTimeout(timeoutId);
        timeoutId = window.setTimeout(() => {
          if (typeof form.requestSubmit === 'function') {
            form.requestSubmit();
          } else {
            form.submit();
          }
        }, 250);
      });
    });
  })();
{% endjs %}
