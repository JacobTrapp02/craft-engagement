{% macro entryLink(aggregate) %}
  {% if aggregate.entry %}
    <a href="{{ aggregate.entry.cpEditUrl }}">{{ aggregate.entry.title }}</a>
  {% else %}
    <span class="light">Element #{{ aggregate.elementId }}</span>
  {% endif %}
{% endmacro %}

{% macro fieldLabel(aggregate) %}
  {% if aggregate.field %}
    {% if aggregate.fieldCpUrl %}
      <a href="{{ aggregate.fieldCpUrl }}">{{ aggregate.field.name }}</a>
    {% else %}
      {{ aggregate.field.name }}
    {% endif %}
  {% else %}
    <span class="light">Field #{{ aggregate.fieldId }}</span>
  {% endif %}
{% endmacro %}

{% macro pager(tab, sort, perPage, pagination) %}
  {% if pagination is defined and pagination.getPageCount() > 1 %}
    <div class="flex" style="margin-top:12px;">
      <div class="light">
        {{ 'Page {current} of {total}'|t('engagement', { current: pagination.getPage() + 1, total: pagination.getPageCount() }) }}
      </div>
      <div style="margin-left:auto;">
        {% if pagination.getPage() > 0 %}
          <a class="btn small" href="{{ cpUrl('engagement/moderation/' ~ tab, { sort: sort, perPage: perPage, p: pagination.getPage() }) }}">{{ 'Previous'|t('engagement') }}</a>
        {% endif %}
        {% if pagination.getPage() + 1 < pagination.getPageCount() %}
          <a class="btn small" href="{{ cpUrl('engagement/moderation/' ~ tab, { sort: sort, perPage: perPage, p: pagination.getPage() + 2 }) }}">{{ 'Next'|t('engagement') }}</a>
        {% endif %}
      </div>
    </div>
  {% endif %}
{% endmacro %}
