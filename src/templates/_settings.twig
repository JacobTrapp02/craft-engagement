{# @var plugin \jtdev\craftengagement\Plugin #}
{# @var settings \jtdev\craftengagement\models\Settings #}

{% import '_includes/forms.twig' as forms %}

{{ forms.textField({
    label: 'Login URL'|t('engagement'),
    instructions: 'Where users should be sent when they need to log in. Can be a path (for example, login) or full URL.'|t('engagement'),
    id: 'loginUrl',
    name: 'loginUrl',
    value: settings.loginUrl,
    required: true,
    errors: settings.getErrors('loginUrl'),
}) }}

{{ forms.textField({
    label: 'Login Redirect Param'|t('engagement'),
    instructions: 'Optional query parameter used to return users after login (for example, redirect). Leave blank to disable.'|t('engagement'),
    id: 'loginRedirectParam',
    name: 'loginRedirectParam',
    value: settings.loginRedirectParam,
    errors: settings.getErrors('loginRedirectParam'),
}) }}

{{ forms.selectField({
    label: 'Guest Interaction Behavior'|t('engagement'),
    instructions: 'When guests click ratings, likes, or favorites that require login, choose whether to show a message or immediately redirect to login.'|t('engagement'),
    id: 'guestInteractionMode',
    name: 'guestInteractionMode',
    value: settings.guestInteractionMode,
    options: [
        { label: 'Show Message on Click'|t('engagement'), value: 'message' },
        { label: 'Auto-Redirect to Login'|t('engagement'), value: 'redirect' },
    ],
    errors: settings.getErrors('guestInteractionMode'),
}) }}

{{ forms.textareaField({
    label: 'Guest Interaction Message'|t('engagement'),
    instructions: 'Message shown inline when Guest Interaction Behavior is set to Show Message on Click. Supports basic HTML links (for example, <a href="/login">Log in</a>).'|t('engagement'),
    id: 'guestInteractionMessage',
    name: 'guestInteractionMessage',
    value: settings.guestInteractionMessage,
    rows: 2,
    errors: settings.getErrors('guestInteractionMessage'),
}) }}
