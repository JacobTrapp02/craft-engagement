{% set widgetUid = random() %}
{% set widgetPreviewMode = previewMode ?? false %}
{% set widgetElementId = elementId ?? null %}
{% set widgetFieldId = fieldId ?? null %}
{% set widgetSiteId = siteId ?? craft.app.sites.currentSite.id %}
{% set widgetScale = scale ?? 5 %}
{% set widgetActionUrl = actionUrl ?? actionUrl('engagement/ratings/cast-rating') %}
{% set widgetAverage = average ?? 0 %}
{% set widgetDisplayAverage = ((widgetAverage * 4)|round) / 4 %}
{% set widgetIcon = icon ?? 'star' %}
{% set widgetEmojiIcon = emojiIcon ?? '⭐' %}
{% set widgetCustomSvg = customSvg ?? null %}
{% set widgetIsLoggedIn = isLoggedIn ?? false %}
{% set widgetUserRating = userRating ?? null %}
{% set widgetLoginUrl = loginUrl ?? url('login') %}
{% set widgetHeadingText = headingText ?? null %}
{% set widgetClickToRateText = clickToRateText ?? 'Click to rate'|t('engagement') %}
{% set widgetYourRatingText = yourRatingText ?? 'Your rating: {userRating} / {scale}'|t('engagement') %}
{% set previewUserRating = widgetUserRating ?? 0 %}
{% set tokenMap = {
  '{userRating}': previewUserRating,
  '{votes}': voteCount ?? 0,
  '{average}': widgetAverage,
  '{roundedAverage}': widgetDisplayAverage,
  '{scale}': widgetScale,
  '{fieldName}': label ?? '',
  '{elementId}': widgetElementId ?? '',
} %}
{% set widgetHeadingTextRendered = widgetHeadingText is not empty ? widgetHeadingText|replace(tokenMap) : '' %}
{% set widgetClickToRateTextRendered = widgetClickToRateText is not empty ? widgetClickToRateText|replace(tokenMap) : '' %}
{% set widgetYourRatingTextRendered = widgetYourRatingText is not empty ? widgetYourRatingText|replace(tokenMap) : '' %}

{% set fillPercent = (widgetUserRating is not null and widgetScale > 0) ? (widgetDisplayAverage / widgetScale * 100) : 0 %}
{% set emptyGlyph = '☆' %}
{% set filledGlyph = '★' %}
{% if widgetIcon == 'heart' %}
  {% set emptyGlyph = '♡' %}
  {% set filledGlyph = '♥' %}
{% elseif widgetIcon == 'thumbs' %}
  {% set emptyGlyph = '👍' %}
  {% set filledGlyph = '👍' %}
{% elseif widgetIcon == 'emoji' %}
  {% set emptyGlyph = widgetEmojiIcon %}
  {% set filledGlyph = widgetEmojiIcon %}
{% endif %}

{% if widgetElementId and widgetFieldId %}
  <div
    data-engagement-rating
    data-rating-uid="{{ widgetUid }}"
    data-element-id="{{ widgetElementId|e('html_attr') }}"
    data-field-id="{{ widgetFieldId|e('html_attr') }}"
    data-site-id="{{ widgetSiteId|e('html_attr') }}"
    data-action-url="{{ widgetActionUrl|e('html_attr') }}"
    data-login-url="{{ widgetLoginUrl|e('html_attr') }}"
    data-is-logged-in="{{ widgetIsLoggedIn ? '1' : '0' }}"
    data-scale="{{ widgetScale|e('html_attr') }}"
    style="text-align:center;"
  >
    {% if widgetHeadingTextRendered is not empty %}
      <div data-rating-heading style="font-size:13px; color:#475569; margin-bottom:6px;">
        {{ widgetHeadingTextRendered }}
      </div>
    {% endif %}

    <div data-overall-wrap>
      <div style="display:inline-block; position:relative; font-size:24px; line-height:1; letter-spacing:1px; margin-bottom:8px;">
        {% if widgetIcon == 'customSvg' and widgetCustomSvg %}
          <span style="display:inline-flex; gap:6px; color:#cbd5e1;">
            {% for _ in 1..widgetScale %}
              <span style="display:inline-flex; width:22px; height:22px; opacity:0.35;">{{ widgetCustomSvg|raw }}</span>
            {% endfor %}
          </span>
          <span data-overall-fill style="position:absolute; left:0; top:0; overflow:hidden; white-space:nowrap; color:#f59e0b; width:{{ fillPercent }}%;">
            <span style="display:inline-flex; gap:6px;">
              {% for _ in 1..widgetScale %}
                <span style="display:inline-flex; width:22px; height:22px;">{{ widgetCustomSvg|raw }}</span>
              {% endfor %}
            </span>
          </span>
        {% elseif widgetIcon == 'emoji' and widgetEmojiIcon %}
          <span style="display:inline-flex; gap:6px;">
            {% for _ in 1..widgetScale %}
              <span style="display:inline-flex; width:22px; height:22px; align-items:center; justify-content:center; opacity:0.3; filter:grayscale(1) saturate(0.2) brightness(0.85);">{{ widgetEmojiIcon }}</span>
            {% endfor %}
          </span>
          <span data-overall-fill style="position:absolute; left:0; top:0; overflow:hidden; white-space:nowrap; width:{{ fillPercent }}%;">
            <span style="display:inline-flex; gap:6px;">
              {% for _ in 1..widgetScale %}
                <span style="display:inline-flex; width:22px; height:22px; align-items:center; justify-content:center;">{{ widgetEmojiIcon }}</span>
              {% endfor %}
            </span>
          </span>
        {% else %}
          <span style="color:#cbd5e1;">
            {% for _ in 1..widgetScale %}{{ emptyGlyph }}{% endfor %}
          </span>
          <span data-overall-fill style="position:absolute; left:0; top:0; overflow:hidden; white-space:nowrap; color:#f59e0b; width:{{ fillPercent }}%;">
            {% for _ in 1..widgetScale %}{{ filledGlyph }}{% endfor %}
          </span>
        {% endif %}
        <div data-rating-stars style="position:absolute; inset:0; display:flex; justify-content:center; gap:6px; align-items:center;">
          {% for value in 1..widgetScale %}
            <button
              type="button"
              data-rating-value="{{ value }}"
              aria-label="{{ 'Rate {value}'|t('engagement', { value: value }) }}"
              style="border:none; background:transparent; padding:0; {{ widgetPreviewMode ? 'cursor:default;' : 'cursor:pointer;' }} line-height:1; font-size:28px; opacity:0;"
            >
              ★
            </button>
          {% endfor %}
        </div>
      </div>
    </div>

    <div data-rating-user style="font-size:13px; color:#334155; min-height:18px;">
      {% if widgetUserRating is not null %}
        {{ widgetYourRatingTextRendered }}
      {% else %}
        {{ widgetClickToRateTextRendered }}
      {% endif %}
    </div>
  </div>

  {% if not widgetPreviewMode %}
  <script>
  (() => {
    const root = document.querySelector('[data-engagement-rating][data-rating-uid="{{ widgetUid }}"]');
    if (!root) {
      return;
    }

    const buttons = root.querySelectorAll('[data-rating-value]');
    const headingEl = root.querySelector('[data-rating-heading]');
    const userEl = root.querySelector('[data-rating-user]');
    const overallFillEl = root.querySelector('[data-overall-fill]');

    const scale = Number(root.getAttribute('data-scale') || 5);
    const actionUrl = root.getAttribute('data-action-url');
    const loginUrl = root.getAttribute('data-login-url') || '/login';
    const isLoggedIn = root.getAttribute('data-is-logged-in') === '1';
    const elementId = Number(root.getAttribute('data-element-id'));
    const fieldId = Number(root.getAttribute('data-field-id'));
    const siteId = Number(root.getAttribute('data-site-id'));
    const fieldName = {{ (label ?? '')|json_encode|raw }};

    let selected = Number({{ widgetUserRating is not null ? widgetUserRating : 0 }});
    const headingTemplate = {{ (widgetHeadingText ?? '')|json_encode|raw }};
    const clickTemplate = {{ (widgetClickToRateText ?? '')|json_encode|raw }};
    const yourTemplate = {{ (widgetYourRatingText ?? '')|json_encode|raw }};
    const initialAverage = Number({{ widgetAverage|json_encode|raw }});
    const initialRoundedAverage = Number({{ widgetDisplayAverage|json_encode|raw }});
    const initialVotes = Number({{ (voteCount ?? 0)|json_encode|raw }});

    const formatText = (template, extra = {}) => {
      if (!template || !template.trim()) {
        return '';
      }

      const values = {
        userRating: extra.userRating ?? selected,
        votes: extra.votes ?? 0,
        average: extra.average ?? 0,
        roundedAverage: extra.roundedAverage ?? 0,
        scale,
        fieldName,
        elementId,
      };

      return template.replace(/\{(userRating|votes|average|roundedAverage|scale|fieldName|elementId)\}/g, (_, token) => {
        const value = values[token];
        return value === null || value === undefined ? '' : String(value);
      });
    };

    const setUserText = (text) => {
      if (!userEl) {
        return;
      }
      userEl.textContent = text || '';
      userEl.style.display = text ? '' : 'none';
    };

    const setHeadingText = (text) => {
      if (!headingEl) {
        return;
      }
      headingEl.textContent = text || '';
      headingEl.style.display = text ? '' : 'none';
    };

    if (selected > 0) {
      setUserText(formatText(yourTemplate, { userRating: selected, scale }));
    } else {
      setUserText(formatText(clickTemplate, { scale }));
    }
    setHeadingText(formatText(headingTemplate, {
      userRating: selected,
      votes: initialVotes,
      average: initialAverage,
      roundedAverage: initialRoundedAverage,
      scale,
    }));

    buttons.forEach((btn) => {
      btn.addEventListener('click', async () => {
        if (!isLoggedIn) {
          const goLogin = window.confirm({{ 'Please log in to rate this.'|t('engagement')|json_encode|raw }});
          if (goLogin) {
            window.location.href = loginUrl;
          }
          return;
        }

        if (!actionUrl || !elementId || !fieldId) {
          return;
        }

        const value = Number(btn.getAttribute('data-rating-value'));
        if (!value || value < 1 || value > scale) {
          return;
        }

        try {
          const response = await fetch(actionUrl, {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json',
              'X-CSRF-Token': {{ craft.app.request.csrfToken|json_encode|raw }},
            },
            body: JSON.stringify({ elementId, fieldId, siteId, rating: value }),
          });

          if (!response.ok) {
            if (userEl) {
              userEl.textContent = {{ 'Could not submit rating right now.'|t('engagement')|json_encode|raw }};
            }
            return;
          }

          const data = await response.json();
          selected = Number(data?.vote?.rating || value);

          if (data?.aggregate && overallFillEl) {
            const avgRaw = Number(data.aggregate.average ?? data.aggregate.roundedAverage ?? 0);
            const avgQuarter = Math.round(avgRaw * 4) / 4;
            const fill = scale > 0 ? (avgQuarter / scale) * 100 : 0;

            overallFillEl.style.width = fill + '%';

            setUserText(formatText(yourTemplate, {
              userRating: selected,
              votes: Number(data.aggregate.voteCount ?? 0),
              average: avgRaw,
              roundedAverage: avgQuarter,
              scale,
            }));

            setHeadingText(formatText(headingTemplate, {
              userRating: selected,
              votes: Number(data.aggregate.voteCount ?? 0),
              average: avgRaw,
              roundedAverage: avgQuarter,
              scale,
            }));
          } else {
            setUserText(formatText(yourTemplate, { userRating: selected, scale }));
          }
        } catch (e) {
          if (userEl) {
            userEl.textContent = {{ 'Could not submit rating right now.'|t('engagement')|json_encode|raw }};
          }
        }
      });
    });
  })();
  </script>
  {% endif %}
{% endif %}
