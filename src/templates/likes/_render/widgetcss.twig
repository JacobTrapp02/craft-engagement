{#
  Likes Widget CSS
  Rendered with `_context` from `likes/_render/widget.twig`.
  Available Twig variables include:
  - widgetUid
  - widgetPreviewMode
  - widgetElementId, widgetFieldId, widgetSiteId
  - widgetActionUrl, widgetLoginUrl
  - widgetIsLoggedIn, widgetGuestAllowed
  - widgetUserVote, widgetLikeCount, widgetDislikeCount
  - widgetIcon, widgetLikeEmojiIcon, widgetDislikeEmojiIcon, widgetLikeCustomSvg, widgetDislikeCustomSvg
  - widgetBeforeLikeColor, widgetAfterLikeColor
  - widgetBeforeDislikeColor, widgetAfterDislikeColor
  - widgetHeadingTextRendered, widgetLikeTextRendered, widgetDislikeTextRendered
#}
[data-engagement-likes] {
  text-align: center;
  font-family: inherit;
}

[data-engagement-likes] [data-likes-heading] {
  font-size: 13px;
  color: #475569;
  margin-bottom: 8px;
}

[data-engagement-likes] .engagement-likes-control {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  border: 1px solid #d1d5db;
  border-radius: 999px;
  overflow: hidden;
  background: #fff;
}

[data-engagement-likes] [data-like-btn] {
  border: none;
  padding: 6px 12px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
  line-height: 1;
  font: inherit;
  font-size: 13px;
  color: #334155;
}

[data-engagement-likes] [data-like-btn="1"] {
  border-radius: 999px 0 0 999px;
}

[data-engagement-likes] [data-like-btn="-1"] {
  border-radius: 0 999px 999px 0;
}

[data-engagement-likes] [data-like-btn]:focus-visible {
  outline: none;
  box-shadow: inset 0 0 0 2px #1d4ed8;
}

[data-engagement-likes] [data-like-label],
[data-engagement-likes] [data-dislike-label] {
  font-size: 13px;
}

[data-engagement-likes] [data-like-label]:empty,
[data-engagement-likes] [data-dislike-label]:empty {
  display: none;
}

[data-engagement-likes] .engagement-likes-divider {
  width: 1px;
  align-self: stretch;
  background: #d1d5db;
}

[data-engagement-likes] [data-like-icon],
[data-engagement-likes] [data-dislike-icon] {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 18px;
  height: 18px;
  flex: 0 0 18px;
}

[data-engagement-likes] .engagement-likes-svg-icon {
  display: inline-flex;
  width: 16px;
  height: 16px;
  vertical-align: middle;
}

[data-engagement-likes] .engagement-guest-message {
  display: inline-block;
  font-size: 13px;
  color: #334155;
  line-height: 1.4;
  padding: 8px 12px;
  border: 1px solid #d1d5db;
  border-radius: 8px;
  background: #f8fafc;
}

[data-engagement-likes] .engagement-guest-message a {
  color: #1d4ed8;
  text-decoration: underline;
}

[data-engagement-likes] .engagement-sr-only {
  position: absolute !important;
  width: 1px !important;
  height: 1px !important;
  padding: 0 !important;
  margin: -1px !important;
  overflow: hidden !important;
  clip: rect(0, 0, 0, 0) !important;
  white-space: nowrap !important;
  border: 0 !important;
}
