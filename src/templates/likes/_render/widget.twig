{% set widgetUid = random() %}
{% set widgetPreviewMode = previewMode ?? false %}
{% set widgetElementId = elementId ?? null %}
{% set widgetFieldId = fieldId ?? null %}
{% set widgetSiteId = siteId ?? craft.app.sites.currentSite.id %}
{% set widgetActionUrl = actionUrl ?? actionUrl('engagement/likes/cast-like') %}
{% set widgetLoginUrl = loginUrl ?? url('login') %}
{% set widgetIsLoggedIn = isLoggedIn ?? false %}
{% set widgetGuestAllowed = guestAllowed ?? false %}
{% set widgetUserVote = userVote ?? null %}
{% set widgetLikeCount = likeCount ?? 0 %}
{% set widgetDislikeCount = dislikeCount ?? 0 %}
{% set widgetIcon = icon ?? 'thumbs' %}
{% set widgetLikeEmojiIcon = likeEmojiIcon ?? emojiIcon ?? '👍' %}
{% set widgetDislikeEmojiIcon = dislikeEmojiIcon ?? '👎' %}
{% set widgetBeforeLikeColor = beforeLikeColor ?? '' %}
{% set widgetAfterLikeColor = afterLikeColor ?? '' %}
{% set widgetBeforeDislikeColor = beforeDislikeColor ?? '' %}
{% set widgetAfterDislikeColor = afterDislikeColor ?? '' %}
{% set widgetLikeBeforeBg = widgetBeforeLikeColor ?: '#fff' %}
{% set widgetLikeAfterBg = widgetAfterLikeColor ?: '#fff' %}
{% set widgetDislikeBeforeBg = widgetBeforeDislikeColor ?: '#fff' %}
{% set widgetDislikeAfterBg = widgetAfterDislikeColor ?: '#fff' %}
{% set widgetCustomSvg = customSvg ?? null %}
{% set widgetHeadingText = headingText ?? '' %}
{% set widgetLikeText = likeText ?? '' %}
{% set widgetDislikeText = dislikeText ?? '' %}
{% set tokenMap = {
  '{likes}': widgetLikeCount,
  '{dislikes}': widgetDislikeCount,
  '{fieldName}': label ?? '',
  '{elementId}': widgetElementId ?? '',
  '{userVote}': widgetUserVote ?? 0,
} %}
{% set widgetHeadingTextRendered = widgetHeadingText is not empty ? widgetHeadingText|replace(tokenMap) : '' %}
{% set widgetLikeTextRendered = widgetLikeText is not empty ? widgetLikeText|replace(tokenMap) : '' %}
{% set widgetDislikeTextRendered = widgetDislikeText is not empty ? widgetDislikeText|replace(tokenMap) : '' %}

{% if widgetElementId and widgetFieldId %}
  <div
    data-engagement-likes
    data-likes-uid="{{ widgetUid }}"
    data-element-id="{{ widgetElementId|e('html_attr') }}"
    data-field-id="{{ widgetFieldId|e('html_attr') }}"
    data-site-id="{{ widgetSiteId|e('html_attr') }}"
    data-action-url="{{ widgetActionUrl|e('html_attr') }}"
    data-login-url="{{ widgetLoginUrl|e('html_attr') }}"
    data-is-logged-in="{{ widgetIsLoggedIn ? '1' : '0' }}"
    data-guest-allowed="{{ widgetGuestAllowed ? '1' : '0' }}"
    style="text-align:center;"
  >
    {% if widgetHeadingTextRendered %}
      <div data-likes-heading style="font-size:13px; color:#475569; margin-bottom:8px;">
        {{ widgetHeadingTextRendered }}
      </div>
    {% endif %}

    <div style="display:inline-flex; justify-content:center; align-items:center; border:1px solid #d1d5db; border-radius:999px; overflow:hidden; background:#fff;">
      <button
        type="button"
        data-like-btn="1"
        style="border:none; padding:6px 12px; background:{{ widgetUserVote == 1 ? widgetLikeAfterBg : widgetLikeBeforeBg }}; {{ widgetPreviewMode ? 'cursor:default;' : 'cursor:pointer;' }}"
      >
        {% if widgetIcon != 'none' %}
          {% set likeIconColor = widgetUserVote == 1 ? (widgetAfterLikeColor ?: '#111827') : (widgetBeforeLikeColor ?: '#111827') %}
          <span data-like-icon style="color:{{ likeIconColor }};">
          {% if widgetIcon == 'emoji' %}
            {{ widgetLikeEmojiIcon }}
          {% elseif widgetIcon == 'customSvg' and widgetCustomSvg %}
            <span style="display:inline-flex; width:16px; height:16px; vertical-align:middle;">{{ widgetCustomSvg|raw }}</span>
          {% else %}
            👍
          {% endif %}
          </span>
        {% endif %}
        <span data-like-label>{{ widgetLikeTextRendered }}</span>
      </button>

      <span aria-hidden="true" style="width:1px; align-self:stretch; background:#d1d5db;"></span>

      <button
        type="button"
        data-like-btn="-1"
        style="border:none; padding:6px 12px; background:{{ widgetUserVote == -1 ? widgetDislikeAfterBg : widgetDislikeBeforeBg }}; {{ widgetPreviewMode ? 'cursor:default;' : 'cursor:pointer;' }}"
      >
        {% if widgetIcon != 'none' %}
          {% set dislikeIconColor = widgetUserVote == -1 ? (widgetAfterDislikeColor ?: '#111827') : (widgetBeforeDislikeColor ?: '#111827') %}
          <span data-dislike-icon style="color:{{ dislikeIconColor }};">
          {% if widgetIcon == 'emoji' %}
            {{ widgetDislikeEmojiIcon }}
          {% elseif widgetIcon == 'customSvg' and widgetCustomSvg %}
            <span style="display:inline-flex; width:16px; height:16px; vertical-align:middle;">{{ widgetCustomSvg|raw }}</span>
          {% else %}
            👎
          {% endif %}
          </span>
        {% endif %}
        <span data-dislike-label>{{ widgetDislikeTextRendered }}</span>
      </button>
    </div>
  </div>

  {% if not widgetPreviewMode %}
  <script>
  (() => {
    const root = document.querySelector('[data-engagement-likes][data-likes-uid="{{ widgetUid }}"]');
    if (!root) {
      return;
    }

    const likeBtn = root.querySelector('[data-like-btn="1"]');
    const dislikeBtn = root.querySelector('[data-like-btn="-1"]');
    const headingEl = root.querySelector('[data-likes-heading]');
    const likeLabelEl = root.querySelector('[data-like-label]');
    const dislikeLabelEl = root.querySelector('[data-dislike-label]');
    const likeIconEl = root.querySelector('[data-like-icon]');
    const dislikeIconEl = root.querySelector('[data-dislike-icon]');

    let userVote = Number({{ widgetUserVote is not null ? widgetUserVote : 0 }});
    let likeCount = Number({{ widgetLikeCount }});
    let dislikeCount = Number({{ widgetDislikeCount }});
    const headingTemplate = {{ widgetHeadingText|json_encode|raw }};
    const likeTemplate = {{ widgetLikeText|json_encode|raw }};
    const dislikeTemplate = {{ widgetDislikeText|json_encode|raw }};
    const beforeLikeColor = {{ widgetBeforeLikeColor|json_encode|raw }};
    const afterLikeColor = {{ widgetAfterLikeColor|json_encode|raw }};
    const beforeDislikeColor = {{ widgetBeforeDislikeColor|json_encode|raw }};
    const afterDislikeColor = {{ widgetAfterDislikeColor|json_encode|raw }};
    const fieldName = {{ (label ?? '')|json_encode|raw }};
    const actionUrl = root.getAttribute('data-action-url');
    const loginUrl = root.getAttribute('data-login-url') || '/login';
    const isLoggedIn = root.getAttribute('data-is-logged-in') === '1';
    const guestAllowed = root.getAttribute('data-guest-allowed') === '1';
    const elementId = Number(root.getAttribute('data-element-id'));
    const fieldId = Number(root.getAttribute('data-field-id'));
    const siteId = Number(root.getAttribute('data-site-id'));

    const formatText = (template, extra = {}) => {
      if (!template || !template.trim()) {
        return '';
      }

      const values = {
        likes: extra.likes ?? likeCount,
        dislikes: extra.dislikes ?? dislikeCount,
        fieldName,
        elementId,
        userVote: extra.userVote ?? userVote,
      };

      return template.replace(/\{(likes|dislikes|fieldName|elementId|userVote)\}/g, (_, token) => {
        const value = values[token];
        return value === null || value === undefined ? '' : String(value);
      });
    };

    const toRgb = (hex) => {
      if (!hex || typeof hex !== 'string') {
        return null;
      }
      const trimmed = hex.trim();
      if (/^#[0-9a-fA-F]{3}$/.test(trimmed)) {
        return {
          r: parseInt(trimmed[1] + trimmed[1], 16),
          g: parseInt(trimmed[2] + trimmed[2], 16),
          b: parseInt(trimmed[3] + trimmed[3], 16),
        };
      }
      if (/^#[0-9a-fA-F]{6}$/.test(trimmed)) {
        return {
          r: parseInt(trimmed.slice(1, 3), 16),
          g: parseInt(trimmed.slice(3, 5), 16),
          b: parseInt(trimmed.slice(5, 7), 16),
        };
      }
      return null;
    };

    const contrastTextColor = (background) => {
      const rgb = toRgb(background);
      if (!rgb) {
        return '';
      }
      const luminance = (0.299 * rgb.r) + (0.587 * rgb.g) + (0.114 * rgb.b);
      return luminance < 140 ? '#fff' : '#000';
    };

    const refreshState = () => {
      if (headingEl) {
        const heading = formatText(headingTemplate);
        headingEl.textContent = heading;
        headingEl.style.display = heading ? '' : 'none';
      }
      if (likeLabelEl) {
        likeLabelEl.textContent = formatText(likeTemplate);
      }
      if (dislikeLabelEl) {
        dislikeLabelEl.textContent = formatText(dislikeTemplate);
      }

      let likeBg = '#fff';
      let dislikeBg = '#fff';
      if (likeBtn instanceof HTMLElement) {
        likeBg = userVote === 1 ? (afterLikeColor || '#fff') : (beforeLikeColor || '#fff');
        likeBtn.style.background = likeBg;
        likeBtn.style.color = contrastTextColor(likeBg);
      }
      if (dislikeBtn instanceof HTMLElement) {
        dislikeBg = userVote === -1 ? (afterDislikeColor || '#fff') : (beforeDislikeColor || '#fff');
        dislikeBtn.style.background = dislikeBg;
        dislikeBtn.style.color = contrastTextColor(dislikeBg);
      }
      if (likeIconEl instanceof HTMLElement) {
        likeIconEl.style.color = (userVote === 1 ? afterLikeColor : beforeLikeColor) || contrastTextColor(likeBg) || '#111827';
      }
      if (dislikeIconEl instanceof HTMLElement) {
        dislikeIconEl.style.color = (userVote === -1 ? afterDislikeColor : beforeDislikeColor) || contrastTextColor(dislikeBg) || '#111827';
      }
    };

    const submitVote = async (value) => {
      if (!isLoggedIn && !guestAllowed) {
        const goLogin = window.confirm({{ 'Please log in to interact.'|t('engagement')|json_encode|raw }});
        if (goLogin) {
          window.location.href = loginUrl;
        }
        return;
      }

      if (!actionUrl || !elementId || !fieldId) {
        return;
      }

      try {
        const response = await fetch(actionUrl, {
          method: 'POST',
          credentials: 'same-origin',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json',
            'X-CSRF-Token': {{ craft.app.request.csrfToken|json_encode|raw }},
          },
          body: JSON.stringify({ elementId, fieldId, siteId, value }),
        });

        if (!response.ok) {
          return;
        }

        const data = await response.json();
        userVote = Number(data?.vote?.value ?? 0);
        likeCount = Number(data?.aggregate?.likeCount ?? 0);
        dislikeCount = Number(data?.aggregate?.dislikeCount ?? 0);
        refreshState();
      } catch (e) {
      }
    };

    likeBtn?.addEventListener('click', () => submitVote(1));
    dislikeBtn?.addEventListener('click', () => submitVote(-1));
    refreshState();
  })();
  </script>
  {% endif %}
{% endif %}
