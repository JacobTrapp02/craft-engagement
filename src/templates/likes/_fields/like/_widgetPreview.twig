{# Shared likes widget preview block for settings + entry editor #}
<div class="field eng-group-card">
  <div class="heading"><label>{{ title }}</label></div>
  {% if instructions is defined and instructions %}
    <div class="instructions"><p>{{ instructions }}</p></div>
  {% endif %}
  <div class="eng-preview-grid">
    <div class="eng-preview-col">
      <div class="eng-preview-title">{{ 'Before Interaction'|t('engagement') }}</div>
      {% include 'engagement/likes/_render/widget.twig' with {
          previewMode: true,
          elementId: elementId,
          fieldId: fieldId,
          siteId: siteId,
          label: label,
          icon: icon,
          likeEmojiIcon: likeEmojiIcon,
          dislikeEmojiIcon: dislikeEmojiIcon,
          beforeLikeColor: beforeLikeColor,
          afterLikeColor: afterLikeColor,
          beforeDislikeColor: beforeDislikeColor,
          afterDislikeColor: afterDislikeColor,
          customSvg: customSvg,
          likeCount: likeCount,
          dislikeCount: dislikeCount,
          headingText: headingText,
          likeText: likeText,
          dislikeText: dislikeText,
          isLoggedIn: true,
          guestAllowed: true,
          userVote: null,
          actionUrl: '#',
          loginUrl: '#',
      } only %}
    </div>
    <div class="eng-preview-col">
      <div class="eng-preview-title">{{ 'After Interaction'|t('engagement') }}</div>
      {% include 'engagement/likes/_render/widget.twig' with {
          previewMode: true,
          elementId: elementId,
          fieldId: fieldId,
          siteId: siteId,
          label: label,
          icon: icon,
          likeEmojiIcon: likeEmojiIcon,
          dislikeEmojiIcon: dislikeEmojiIcon,
          beforeLikeColor: beforeLikeColor,
          afterLikeColor: afterLikeColor,
          beforeDislikeColor: beforeDislikeColor,
          afterDislikeColor: afterDislikeColor,
          customSvg: customSvg,
          likeCount: likeCount,
          dislikeCount: dislikeCount,
          headingText: headingText,
          likeText: likeText,
          dislikeText: dislikeText,
          isLoggedIn: true,
          guestAllowed: true,
          userVote: afterUserVote,
          actionUrl: '#',
          loginUrl: '#',
      } only %}
    </div>
  </div>
</div>
