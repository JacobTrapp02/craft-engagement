{% include 'engagement/likes/_fields/like/_widgetPreview.twig' with {
    title: 'Widget Preview'|t('engagement'),
    instructions: 'Live preview of the like/dislike widget before and after interaction.'|t('engagement'),
    elementId: 1,
    fieldId: 1,
    siteId: 1,
    label: field.name ?? 'Likes'|t('engagement'),
    icon: field.icon,
    likeEmojiIcon: field.likeEmojiIcon,
    dislikeEmojiIcon: field.dislikeEmojiIcon,
    beforeLikeColor: field.beforeLikeColor,
    afterLikeColor: field.afterLikeColor,
    beforeDislikeColor: field.beforeDislikeColor,
    afterDislikeColor: field.afterDislikeColor,
    customSvg: field.customSvg,
    likeCount: 21,
    dislikeCount: 4,
    headingText: field.headingText,
    likeText: field.likeText,
    dislikeText: field.dislikeText,
    afterUserVote: 1,
} only %}

{% include 'engagement/likes/_fields/like/settings/_sectionIconAppearance.twig' with {
    field: field,
    iconOptions: iconOptions,
} only %}

{% include 'engagement/likes/_fields/like/settings/_sectionBehavior.twig' with {
    field: field,
} only %}

{% include 'engagement/likes/_fields/like/settings/_sectionTextOverrides.twig' with {
    field: field,
} only %}

{% include 'engagement/likes/_fields/like/settings/_sectionEditorOverrides.twig' with {
    field: field,
} only %}

{% js %}
(() => {
  const panels = document.querySelectorAll('[data-icon-mode-panel]');
  const getIconSelect = () => document.querySelector('[data-icon-mode-source="1"]');
  const colorPairs = document.querySelectorAll('.eng-color-pair');

  const toSixDigitHex = (value) => {
    if (typeof value !== 'string') {
      return null;
    }
    const trimmed = value.trim();
    if (/^#[0-9a-fA-F]{6}$/.test(trimmed)) {
      return trimmed.toLowerCase();
    }
    if (/^#[0-9a-fA-F]{3}$/.test(trimmed)) {
      const r = trimmed[1];
      const g = trimmed[2];
      const b = trimmed[3];
      return `#${r}${r}${g}${g}${b}${b}`.toLowerCase();
    }
    return null;
  };

  const syncIconPanels = () => {
    const iconSelect = getIconSelect();
    if (!iconSelect) {
      return;
    }
    const mode = iconSelect.value;
    panels.forEach((panel) => {
      if (panel instanceof HTMLElement) {
        panel.style.display = panel.dataset.iconModePanel === mode ? '' : 'none';
      }
    });
  };

  const syncColorPairs = () => {
    colorPairs.forEach((pair) => {
      if (!(pair instanceof HTMLElement)) {
        return;
      }
      const picker = pair.querySelector('[data-eng-color-picker="1"]');
      const textInput = pair.querySelector('[data-eng-color-text="1"]');
      if (!(picker instanceof HTMLInputElement) || !(textInput instanceof HTMLInputElement)) {
        return;
      }

      if (picker.dataset.engColorBound === '1') {
        return;
      }
      picker.dataset.engColorBound = '1';

      const setPickerFromText = () => {
        const normalized = toSixDigitHex(textInput.value);
        if (normalized) {
          picker.value = normalized;
        }
      };

      picker.addEventListener('input', () => {
        textInput.value = picker.value;
      });
      textInput.addEventListener('input', setPickerFromText);
      setPickerFromText();
    });
  };

  document.addEventListener('change', (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement)) {
      return;
    }

    if (target.matches('[data-icon-mode-source="1"]')) {
      syncIconPanels();
    }
  });

  syncIconPanels();
  syncColorPairs();
  requestAnimationFrame(syncIconPanels);
  requestAnimationFrame(syncColorPairs);
})();
{% endjs %}

{% css %}
.eng-group-card {
  border: 1px solid #d6d9de;
  border-radius: 10px;
  background: #f9fafb;
  padding: 12px;
  margin-bottom: 14px;
}

.eng-disclosure {
  margin: 14px 0;
  border: 1px solid #d6d9de;
  border-radius: 10px;
  background: #f9fafb;
  padding: 12px;
}

.eng-disclosure > summary {
  cursor: pointer;
  font-weight: 600;
  display: list-item;
  margin-bottom: 0;
}

.eng-disclosure[open] > summary {
  margin-bottom: 10px;
}

.eng-disclosure .eng-group-card {
  border: 0;
  background: transparent;
  padding: 0;
  margin-bottom: 0;
}

.eng-editor-master {
  padding-bottom: 10px;
  margin-bottom: 10px;
  border-bottom: 1px solid #e5e7eb;
}

.eng-subgroup-card {
  border: 1px solid #e5e7eb !important;
  background: #fff !important;
  border-radius: 8px;
  padding: 12px;
}

.eng-disclosure .eng-subgroup-card {
  padding: 12px;
}

.eng-preview-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.eng-preview-col {
  border: 1px solid #e5e7eb;
  border-radius: 8px;
  background: #fff;
  padding: 10px;
}

.eng-preview-title {
  font-size: 12px;
  font-weight: 600;
  color: #64748b;
  margin-bottom: 8px;
}

.eng-color-matrix {
  margin-top: 10px;
  display: grid;
  grid-template-columns: 100px minmax(0, 1fr) minmax(0, 1fr);
  gap: 10px 12px;
  align-items: start;
}

.eng-color-matrix__header {
  font-size: 12px;
  font-weight: 700;
  color: #334155;
  text-transform: uppercase;
  letter-spacing: 0.03em;
}

.eng-color-matrix__row {
  font-size: 13px;
  font-weight: 600;
  color: #334155;
  padding-top: 6px;
}
{% endcss %}
