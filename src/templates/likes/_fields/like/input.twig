{# @var field \jtdev\craftengagement\fields\LikesField #}
{# @var like \jtdev\craftengagement\models\Like #}

{% import '_includes/forms.twig' as forms %}

{% set prefix = field.handle %}
{% set canOverrideEnabled = field.allowEditorOverrides and field.allowOverrideWidgetEnabled %}
{% set canOverrideIcon = field.allowEditorOverrides and field.allowOverrideIconAppearance %}
{% set canOverrideColors = field.allowEditorOverrides and field.allowOverrideIconColors %}
{% set canOverrideGuests = field.allowEditorOverrides and field.allowOverrideGuestInteractions %}
{% set canOverrideVoteChange = field.allowEditorOverrides and field.allowOverrideUserVoteChange %}
{% set canOverrideText = field.allowEditorOverrides and (field.allowOverrideHeadingText or field.allowOverrideLikeText or field.allowOverrideDislikeText) %}
{% set canShowWidgetPreview = field.allowEditorOverrides and field.allowOverrideWidgetPreview %}

<div class="eng-entry-settings" data-like-entry-settings>
  <div class="eng-entry-title">{{ 'Likes Settings'|t('engagement') }}</div>

  <div class="readable eng-entry-aggregate">
    <div class="eng-entry-aggregate-value">
      {{ 'Likes {likes} • Dislikes {dislikes}'|t('engagement', {
        likes: like.likeCount,
        dislikes: like.dislikeCount,
      }) }}
    </div>
  </div>

  {% if canOverrideEnabled %}
    {{ forms.lightswitchField({
        label: 'Enabled for This Element'|t('engagement'),
        id: prefix ~ '-enabled',
        name: prefix ~ '[enabled]',
        on: like.enabled,
    }) }}
  {% endif %}

  {% if canShowWidgetPreview %}
    {% include 'engagement/likes/_fields/like/_widgetPreview.twig' with {
        title: 'Widget Preview'|t('engagement'),
        instructions: null,
        elementId: 1,
        fieldId: field.id ?? 1,
        siteId: craft.app.sites.currentSite.id,
        label: field.name ?? 'Likes'|t('engagement'),
        icon: like.icon,
        likeEmojiIcon: like.likeEmojiIcon,
        dislikeEmojiIcon: like.dislikeEmojiIcon,
        beforeLikeColor: like.beforeLikeColor,
        afterLikeColor: like.afterLikeColor,
        beforeDislikeColor: like.beforeDislikeColor,
        afterDislikeColor: like.afterDislikeColor,
        customSvg: like.customSvg,
        likeCount: like.likeCount ?: 0,
        dislikeCount: like.dislikeCount ?: 0,
        headingText: like.headingText,
        likeText: like.likeText,
        dislikeText: like.dislikeText,
        afterUserVote: 1,
    } only %}
  {% endif %}

  {% if canOverrideIcon or canOverrideColors %}
    {% include 'engagement/likes/_fields/like/input/_sectionIconAppearance.twig' with {
        prefix: prefix,
        like: like,
        iconOptions: iconOptions,
        canOverrideIcon: canOverrideIcon,
        canOverrideColors: canOverrideColors,
    } only %}
  {% endif %}

  {% if canOverrideGuests or canOverrideVoteChange %}
    {% include 'engagement/likes/_fields/like/input/_sectionBehavior.twig' with {
        prefix: prefix,
        like: like,
        canOverrideGuests: canOverrideGuests,
        canOverrideVoteChange: canOverrideVoteChange,
    } only %}
  {% endif %}

  {% if canOverrideText %}
    {% include 'engagement/likes/_fields/like/input/_sectionTextOverrides.twig' with {
        prefix: prefix,
        field: field,
        like: like,
    } only %}
  {% endif %}
</div>

{% js %}
(() => {
  const roots = document.querySelectorAll('[data-like-entry-settings]');
  const toSixDigitHex = (value) => {
    if (typeof value !== 'string') {
      return null;
    }
    const trimmed = value.trim();
    if (/^#[0-9a-fA-F]{6}$/.test(trimmed)) {
      return trimmed.toLowerCase();
    }
    if (/^#[0-9a-fA-F]{3}$/.test(trimmed)) {
      const r = trimmed[1];
      const g = trimmed[2];
      const b = trimmed[3];
      return `#${r}${r}${g}${g}${b}${b}`.toLowerCase();
    }
    return null;
  };

  roots.forEach((root) => {
    const panels = root.querySelectorAll('[data-entry-icon-mode-panel]');
    const select = root.querySelector('[data-entry-icon-mode-source="1"]');
    const colorPairs = root.querySelectorAll('.eng-color-pair');
    if (!(select instanceof HTMLSelectElement)) {
      // Continue to color picker sync even when icon override select is hidden.
    }

    const syncPanels = () => {
      if (!(select instanceof HTMLSelectElement)) {
        return;
      }
      const mode = select.value;
      panels.forEach((panel) => {
        if (panel instanceof HTMLElement) {
          panel.style.display = panel.dataset.entryIconModePanel === mode ? '' : 'none';
        }
      });
    };

    const syncColorPairs = () => {
      colorPairs.forEach((pair) => {
        if (!(pair instanceof HTMLElement)) {
          return;
        }
        const picker = pair.querySelector('[data-eng-color-picker="1"]');
        const textInput = pair.querySelector('[data-eng-color-text="1"]');
        if (!(picker instanceof HTMLInputElement) || !(textInput instanceof HTMLInputElement)) {
          return;
        }

        if (picker.dataset.engColorBound === '1') {
          return;
        }
        picker.dataset.engColorBound = '1';

        const setPickerFromText = () => {
          const normalized = toSixDigitHex(textInput.value);
          if (normalized) {
            picker.value = normalized;
          }
        };

        picker.addEventListener('input', () => {
          textInput.value = picker.value;
        });
        textInput.addEventListener('input', setPickerFromText);
        setPickerFromText();
      });
    };

    if (select instanceof HTMLSelectElement) {
      select.addEventListener('change', syncPanels);
    }
    syncPanels();
    syncColorPairs();
    requestAnimationFrame(syncPanels);
    requestAnimationFrame(syncColorPairs);
  });
})();
{% endjs %}

{% css %}
.eng-entry-settings {
  border: 1px solid #d6d9de;
  border-radius: 8px;
  background: #f7f8fa;
  padding: 14px;
}

.eng-entry-title {
  font-size: 12px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: #5c6b7a;
  margin-bottom: 8px;
}

.eng-entry-aggregate {
  margin-bottom: 12px;
  color: #3f4d5a;
}

.eng-entry-aggregate-value {
  font-weight: 600;
}

.eng-disclosure {
  margin: 12px 0;
  border: 1px solid #d6d9de;
  border-radius: 10px;
  background: #f9fafb;
  padding: 12px;
}

.eng-disclosure > summary {
  cursor: pointer;
  font-weight: 600;
  display: list-item;
  margin-bottom: 0;
}

.eng-disclosure[open] > summary {
  margin-bottom: 10px;
}

.eng-group-card {
  border: 1px solid #d6d9de;
  border-radius: 10px;
  background: #f9fafb;
  padding: 12px;
}

.eng-disclosure .eng-group-card {
  border: 0;
  background: transparent;
  padding: 0;
  margin-bottom: 0;
}

.eng-preview-grid {
  margin-top: 4px;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.eng-preview-col {
  border: 1px solid #e5e7eb;
  border-radius: 8px;
  background: #fff;
  padding: 10px;
}

.eng-preview-title {
  font-size: 12px;
  font-weight: 600;
  color: #64748b;
  margin-bottom: 8px;
}

.eng-color-matrix {
  margin-top: 10px;
  display: grid;
  grid-template-columns: 100px minmax(0, 1fr) minmax(0, 1fr);
  gap: 10px 12px;
  align-items: start;
}

.eng-color-matrix__header {
  font-size: 12px;
  font-weight: 700;
  color: #334155;
  text-transform: uppercase;
  letter-spacing: 0.03em;
}

.eng-color-matrix__row {
  font-size: 13px;
  font-weight: 600;
  color: #334155;
  padding-top: 6px;
}
{% endcss %}
