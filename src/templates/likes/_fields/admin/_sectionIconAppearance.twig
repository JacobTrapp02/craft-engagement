{% import '_includes/forms.twig' as forms %}

{% set hasIconAppearanceErrors =
  field.getErrors('icon')|length
  or field.getErrors('likeEmojiIcon')|length
  or field.getErrors('dislikeEmojiIcon')|length
  or field.getErrors('likeCustomSvg')|length
  or field.getErrors('dislikeCustomSvg')|length
  or field.getErrors('beforeLikeColor')|length
  or field.getErrors('afterLikeColor')|length
  or field.getErrors('beforeDislikeColor')|length
  or field.getErrors('afterDislikeColor')|length
%}

<details class="eng-disclosure" {% if hasIconAppearanceErrors %}open{% endif %}>
  <summary>{{ 'Icon Appearance'|t('engagement') }}</summary>
  <div class="field eng-group-card">
    <div class="instructions"><p>{{ 'Set icon colors before and after a vote. These apply to icon mode states (like/dislike and favorited/unfavorited).'|t('engagement') }}</p></div>
    {{ forms.selectField({
        label: 'Icon Mode'|t('engagement'),
        id: 'icon',
        name: 'icon',
        options: iconOptions,
        value: field.icon,
        errors: field.getErrors('icon'),
        inputAttributes: {
            'data-icon-mode-source': '1',
        },
    }) }}

    <div data-icon-mode-panel="emoji" style="{{ field.icon == 'emoji' ? '' : 'display:none;' }}">
      {% include 'engagement/_partials/emojiPicker.twig' with {
          label: 'Like Emoji Icon'|t('engagement'),
          instructions: 'Paste an emoji or choose one with Pick Emoji.'|t('engagement'),
          inputId: 'likeEmojiIcon',
          inputName: 'likeEmojiIcon',
          inputValue: field.likeEmojiIcon,
          errors: field.getErrors('likeEmojiIcon'),
      } only %}

      {% include 'engagement/_partials/emojiPicker.twig' with {
          label: 'Dislike Emoji Icon'|t('engagement'),
          instructions: 'Set the emoji used for the dislike button.'|t('engagement'),
          inputId: 'dislikeEmojiIcon',
          inputName: 'dislikeEmojiIcon',
          inputValue: field.dislikeEmojiIcon,
          errors: field.getErrors('dislikeEmojiIcon'),
      } only %}
    </div>

    <div data-icon-mode-panel="customSvg" style="{{ field.icon == 'customSvg' ? '' : 'display:none;' }}">
      {{ forms.textareaField({
          label: 'Like Custom SVG Markup'|t('engagement'),
          id: 'likeCustomSvg',
          name: 'likeCustomSvg',
          value: field.likeCustomSvg,
          errors: field.getErrors('likeCustomSvg'),
          rows: 6,
      }) }}
      {{ forms.textareaField({
          label: 'Dislike Custom SVG Markup'|t('engagement'),
          id: 'dislikeCustomSvg',
          name: 'dislikeCustomSvg',
          value: field.dislikeCustomSvg,
          errors: field.getErrors('dislikeCustomSvg'),
          rows: 6,
      }) }}
    </div>

    <div class="eng-color-matrix">
      <div></div>
      <div class="eng-color-matrix__header">{{ 'Like'|t('engagement') }}</div>
      <div class="eng-color-matrix__header">{{ 'Dislike'|t('engagement') }}</div>

      <div class="eng-color-matrix__row">{{ 'Before'|t('engagement') }}</div>
      <div>
        {% include 'engagement/_partials/colorFieldWithPicker.twig' with {
            label: 'Like Color'|t('engagement'),
            id: 'beforeLikeColor',
            name: 'beforeLikeColor',
            value: field.beforeLikeColor,
            errors: field.getErrors('beforeLikeColor'),
            defaultColor: '#64748b',
        } only %}
      </div>
      <div>
        {% include 'engagement/_partials/colorFieldWithPicker.twig' with {
            label: 'Dislike Color'|t('engagement'),
            id: 'beforeDislikeColor',
            name: 'beforeDislikeColor',
            value: field.beforeDislikeColor,
            errors: field.getErrors('beforeDislikeColor'),
            defaultColor: '#64748b',
        } only %}
      </div>

      <div class="eng-color-matrix__row">{{ 'After'|t('engagement') }}</div>
      <div>
        {% include 'engagement/_partials/colorFieldWithPicker.twig' with {
            label: 'Like Color'|t('engagement'),
            id: 'afterLikeColor',
            name: 'afterLikeColor',
            value: field.afterLikeColor,
            errors: field.getErrors('afterLikeColor'),
            defaultColor: '#0369a1',
        } only %}
      </div>
      <div>
        {% include 'engagement/_partials/colorFieldWithPicker.twig' with {
            label: 'Dislike Color'|t('engagement'),
            id: 'afterDislikeColor',
            name: 'afterDislikeColor',
            value: field.afterDislikeColor,
            errors: field.getErrors('afterDislikeColor'),
            defaultColor: '#b91c1c',
        } only %}
      </div>
    </div>
  </div>
</details>
