{% js %}
(() => {
  window.__engagementSharedFieldAssets = window.__engagementSharedFieldAssets || {};
  const sharedState = window.__engagementSharedFieldAssets;

  const toSixDigitHex = (value) => {
    if (typeof value !== 'string') {
      return null;
    }
    const trimmed = value.trim();
    if (/^#[0-9a-fA-F]{6}$/.test(trimmed)) {
      return trimmed.toLowerCase();
    }
    if (/^#[0-9a-fA-F]{3}$/.test(trimmed)) {
      const r = trimmed[1];
      const g = trimmed[2];
      const b = trimmed[3];
      return `#${r}${r}${g}${g}${b}${b}`.toLowerCase();
    }
    return null;
  };

  const bindColorPairs = (scope = document) => {
    const pairs = scope.querySelectorAll('.eng-color-pair');
    pairs.forEach((pair) => {
      if (!(pair instanceof HTMLElement)) {
        return;
      }
      const picker = pair.querySelector('[data-eng-color-picker="1"]');
      const textInput = pair.querySelector('[data-eng-color-text="1"]');
      if (!(picker instanceof HTMLInputElement) || !(textInput instanceof HTMLInputElement)) {
        return;
      }

      if (picker.dataset.engColorBound === '1') {
        return;
      }
      picker.dataset.engColorBound = '1';

      const syncPickerFromText = () => {
        const normalized = toSixDigitHex(textInput.value);
        if (normalized) {
          picker.value = normalized;
        }
      };

      picker.addEventListener('input', () => {
        textInput.value = picker.value;
      });
      textInput.addEventListener('input', syncPickerFromText);
      syncPickerFromText();
    });
  };

  const syncSettingsIconPanels = () => {
    const select = document.querySelector('[data-icon-mode-source="1"]');
    if (!(select instanceof HTMLSelectElement)) {
      return;
    }
    const mode = select.value;
    const panels = document.querySelectorAll('[data-icon-mode-panel]');
    panels.forEach((panel) => {
      if (panel instanceof HTMLElement) {
        panel.style.display = panel.dataset.iconModePanel === mode ? '' : 'none';
      }
    });
  };

  const syncEntryPanels = (root) => {
    if (!(root instanceof HTMLElement)) {
      return;
    }
    const select = root.querySelector('[data-entry-icon-mode-source="1"]');
    if (!(select instanceof HTMLSelectElement)) {
      return;
    }
    const mode = select.value;
    const panels = root.querySelectorAll('[data-entry-icon-mode-panel]');
    panels.forEach((panel) => {
      if (panel instanceof HTMLElement) {
        panel.style.display = panel.dataset.entryIconModePanel === mode ? '' : 'none';
      }
    });
  };

  const initEntryRoots = (scope = document) => {
    const roots = scope.querySelectorAll('[data-rating-entry-settings], [data-like-entry-settings], [data-favorite-entry-settings]');
    roots.forEach((root) => {
      if (!(root instanceof HTMLElement)) {
        return;
      }
      bindColorPairs(root);
      syncEntryPanels(root);
      requestAnimationFrame(() => syncEntryPanels(root));
    });
  };

  const initAll = () => {
    bindColorPairs(document);
    initEntryRoots(document);
    syncSettingsIconPanels();
    requestAnimationFrame(() => {
      bindColorPairs(document);
      initEntryRoots(document);
      syncSettingsIconPanels();
    });
  };

  if (!sharedState.listenersBound) {
    sharedState.listenersBound = true;

    document.addEventListener('change', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) {
        return;
      }

      if (target.matches('[data-icon-mode-source="1"]')) {
        syncSettingsIconPanels();
      }

      if (target.matches('[data-entry-icon-mode-source="1"]')) {
        const root = target.closest('[data-rating-entry-settings], [data-like-entry-settings], [data-favorite-entry-settings]');
        if (root instanceof HTMLElement) {
          syncEntryPanels(root);
        }
      }
    });

    sharedState.observer = new MutationObserver((mutations) => {
      mutations.forEach((mutation) => {
        mutation.addedNodes.forEach((node) => {
          if (!(node instanceof HTMLElement)) {
            return;
          }

          if (node.matches('[data-rating-entry-settings], [data-like-entry-settings], [data-favorite-entry-settings]')) {
            bindColorPairs(node);
            syncEntryPanels(node);
            requestAnimationFrame(() => syncEntryPanels(node));
          } else {
            bindColorPairs(node);
            initEntryRoots(node);
          }
        });
      });
    });

    if (document.body) {
      sharedState.observer.observe(document.body, { childList: true, subtree: true });
    }
  }

  initAll();
})();
{% endjs %}

{% css %}
.eng-group-card {
  border: 1px solid #d6d9de;
  border-radius: 10px;
  background: #f9fafb;
  padding: 12px;
  margin-bottom: 14px;
}

.eng-disclosure {
  margin: 14px 0;
  border: 1px solid #d6d9de;
  border-radius: 10px;
  background: #f9fafb;
  padding: 12px;
}

.eng-disclosure > summary {
  cursor: pointer;
  font-weight: 600;
  display: list-item;
  margin-bottom: 0;
}

.eng-disclosure[open] > summary {
  margin-bottom: 10px;
}

.eng-disclosure .eng-group-card {
  border: 0;
  background: transparent;
  padding: 0;
  margin-bottom: 0;
}

.eng-editor-master {
  padding-bottom: 10px;
  margin-bottom: 10px;
  border-bottom: 1px solid #e5e7eb;
}

.eng-subgroup-card {
  border: 1px solid #e5e7eb !important;
  background: #fff !important;
  border-radius: 8px;
  padding: 12px;
}

.eng-disclosure .eng-subgroup-card {
  padding: 12px;
}

.eng-preview-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.eng-preview-col {
  border: 1px solid #e5e7eb;
  border-radius: 8px;
  background: #fff;
  padding: 10px;
}

.eng-preview-title {
  font-size: 12px;
  font-weight: 600;
  color: #64748b;
  margin-bottom: 8px;
}

.eng-entry-settings {
  border: 1px solid #d6d9de;
  border-radius: 8px;
  background: #f7f8fa;
  padding: 14px;
}

.eng-entry-title {
  font-size: 12px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: #5c6b7a;
  margin-bottom: 8px;
}

.eng-entry-aggregate {
  margin-bottom: 12px;
  color: #3f4d5a;
}

.eng-entry-aggregate-value {
  font-weight: 600;
}

.eng-entry-settings .eng-disclosure {
  margin: 12px 0;
}

.eng-entry-settings .eng-preview-grid {
  margin-top: 4px;
}

.eng-color-matrix {
  margin-top: 10px;
  display: grid;
  grid-template-columns: 100px minmax(0, 1fr) minmax(0, 1fr);
  gap: 10px 12px;
  align-items: start;
}

.eng-color-matrix__header {
  font-size: 12px;
  font-weight: 700;
  color: #334155;
  text-transform: uppercase;
  letter-spacing: 0.03em;
}

.eng-color-matrix__row {
  font-size: 13px;
  font-weight: 600;
  color: #334155;
  padding-top: 6px;
}
{% endcss %}
