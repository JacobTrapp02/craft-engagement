{#
  Ratings Widget Resolver
  Available Twig variables (inputs and overrides):
  - previewMode, elementId, fieldId, siteId
  - actionUrl, loginUrl
  - guestInteractionMode, guestInteractionMessage, guestInteractionMessageHtml
  - isLoggedIn, guestAllowed
  - scale, average, roundedAverage, voteCount, userRating
  - icon, emojiIcon, customSvg
  - headingText, clickToRateText, yourRatingText
  - label
  - widgetTemplates (optional per-call overrides: html/css/js)
  - widgetMode (`normal` or `deferred`), widgetConfig (CSRF-token-free client config)
#}
{% set widgetMode = widgetMode ?? 'normal' %}
{% set widgetConfig = widgetConfig ?? {} %}
{% set widgetUid = widgetUid ?? random() %}
{% set widgetPreviewMode = previewMode ?? false %}
{% set widgetElementId = elementId ?? null %}
{% set widgetFieldId = fieldId ?? null %}
{% set widgetSiteId = siteId ?? craft.app.sites.currentSite.id %}
{% set widgetScale = scale ?? 5 %}
{% set widgetActionUrl = actionUrl ?? actionUrl('engagement/ratings/cast-rating') %}
{% set widgetAverage = average ?? 0 %}
{% set widgetDisplayAverage = ((widgetAverage * 4)|round) / 4 %}
{% set widgetIcon = icon ?? 'star' %}
{% set widgetEmojiIcon = emojiIcon ?? '⭐' %}
{% set widgetCustomSvg = customSvg ?? null %}
{% set widgetIsLoggedIn = isLoggedIn ?? false %}
{% set widgetGuestAllowed = guestAllowed ?? false %}
{% set widgetUserRating = userRating ?? null %}
{% set widgetLoginUrl = loginUrl ?? url('login') %}
{% set widgetGuestInteractionMode = guestInteractionMode ?? 'message' %}
{% set widgetGuestInteractionMessage = guestInteractionMessage ?? 'Please log in or register to interact.'|t('engagement') %}
{% set widgetGuestInteractionMessageHtml = guestInteractionMessageHtml ?? widgetGuestInteractionMessage %}
{% set widgetHeadingText = headingText ?? null %}
{% set widgetClickToRateText = clickToRateText ?? '' %}
{% set widgetYourRatingText = yourRatingText ?? '' %}
{% set previewUserRating = widgetUserRating ?? 0 %}
{% set tokenMap = {
  '{userRating}': previewUserRating,
  '{votes}': voteCount ?? 0,
  '{average}': widgetAverage,
  '{roundedAverage}': widgetDisplayAverage,
  '{scale}': widgetScale,
  '{fieldName}': label ?? '',
  '{elementId}': widgetElementId ?? '',
} %}
{% set widgetHeadingTextRendered = widgetHeadingText is not empty ? widgetHeadingText|replace(tokenMap) : '' %}
{% set widgetClickToRateTextRendered = widgetClickToRateText is not empty ? widgetClickToRateText|replace(tokenMap) : '' %}
{% set widgetYourRatingTextRendered = widgetYourRatingText is not empty ? widgetYourRatingText|replace(tokenMap) : '' %}

{% set fillPercent = widgetScale > 0 ? (widgetDisplayAverage / widgetScale * 100) : 0 %}
{% set emptyGlyph = '☆' %}
{% set filledGlyph = '★' %}
{% if widgetIcon == 'heart' %}
  {% set emptyGlyph = '♡' %}
  {% set filledGlyph = '♥' %}
{% elseif widgetIcon == 'thumbs' %}
  {% set emptyGlyph = '👍' %}
  {% set filledGlyph = '👍' %}
{% elseif widgetIcon == 'emoji' %}
  {% set emptyGlyph = widgetEmojiIcon %}
  {% set filledGlyph = widgetEmojiIcon %}
{% endif %}

{% set widgetDefaults = {
  html: 'engagement/ratings/_render/widgethtml',
  css: 'engagement/ratings/_render/widgetcss',
  js: 'engagement/ratings/_render/widgetjs',
} %}
{% set engagementConfig = craft.app.config.getConfigFromFile('engagement') ?? {} %}
{% set configWidgetTemplates = engagementConfig.widgetTemplates ?? {} %}
{% set configOverrides = attribute(configWidgetTemplates, 'ratings') ?? {} %}
{% set requestedTemplates = widgetDefaults|merge(configOverrides)|merge(widgetTemplates ?? {}) %}
{% set templateModeSite = constant('craft\\web\\View::TEMPLATE_MODE_SITE') %}
{% set templateModeCp = constant('craft\\web\\View::TEMPLATE_MODE_CP') %}

{% set requestedHtmlTemplate = requestedTemplates.html ?? '' %}
{% set widgetHtmlTemplate = widgetDefaults.html %}
{% set widgetHtmlTemplateMode = templateModeCp %}
{% if requestedHtmlTemplate and craft.app.view.doesTemplateExist(requestedHtmlTemplate, templateModeSite) %}
  {% set widgetHtmlTemplate = requestedHtmlTemplate %}
  {% set widgetHtmlTemplateMode = templateModeSite %}
{% elseif requestedHtmlTemplate and craft.app.view.doesTemplateExist(requestedHtmlTemplate, templateModeCp) %}
  {% set widgetHtmlTemplate = requestedHtmlTemplate %}
{% endif %}

{% set requestedCssTemplate = requestedTemplates.css ?? '' %}
{% set widgetCssTemplate = widgetDefaults.css %}
{% set widgetCssTemplateMode = templateModeCp %}
{% if requestedCssTemplate and craft.app.view.doesTemplateExist(requestedCssTemplate, templateModeSite) %}
  {% set widgetCssTemplate = requestedCssTemplate %}
  {% set widgetCssTemplateMode = templateModeSite %}
{% elseif requestedCssTemplate and craft.app.view.doesTemplateExist(requestedCssTemplate, templateModeCp) %}
  {% set widgetCssTemplate = requestedCssTemplate %}
{% endif %}

{% set requestedJsTemplate = requestedTemplates.js ?? '' %}
{% set widgetJsTemplate = widgetDefaults.js %}
{% set widgetJsTemplateMode = templateModeCp %}
{% if requestedJsTemplate and craft.app.view.doesTemplateExist(requestedJsTemplate, templateModeSite) %}
  {% set widgetJsTemplate = requestedJsTemplate %}
  {% set widgetJsTemplateMode = templateModeSite %}
{% elseif requestedJsTemplate and craft.app.view.doesTemplateExist(requestedJsTemplate, templateModeCp) %}
  {% set widgetJsTemplate = requestedJsTemplate %}
{% endif %}

{% if widgetElementId and widgetFieldId %}
  <style>{{ craft.app.view.renderTemplate(widgetCssTemplate, _context, widgetCssTemplateMode)|raw }}</style>
  {% if widgetMode == 'deferred' %}
    <div
      id="{{ widgetUid|e('html_attr') }}"
      data-engagement-deferred
      data-engagement-type="rating"
      data-engagement-config="{{ widgetConfig|json_encode|e('html_attr') }}"
    >{{ craft.app.view.renderTemplate(widgetHtmlTemplate, _context, widgetHtmlTemplateMode)|raw }}</div>
  {% elseif widgetMode == 'shell' %}
    <div data-engagement-rating-shell aria-hidden="true" inert>
      {{ craft.app.view.renderTemplate(widgetHtmlTemplate, _context, widgetHtmlTemplateMode)|raw }}
    </div>
  {% else %}
    {{ craft.app.view.renderTemplate(widgetHtmlTemplate, _context, widgetHtmlTemplateMode)|raw }}
  {% endif %}

  {% if not widgetPreviewMode and widgetMode != 'deferred' %}
  <script>{{ craft.app.view.renderTemplate(widgetJsTemplate, _context, widgetJsTemplateMode)|raw }}</script>
  {% endif %}
{% endif %}
