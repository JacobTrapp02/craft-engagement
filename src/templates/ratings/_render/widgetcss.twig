{#
  Ratings Widget CSS
  Rendered with `_context` from `ratings/_render/widget.twig`.
  Available Twig variables include:
  - widgetUid
  - widgetPreviewMode
  - widgetElementId, widgetFieldId, widgetSiteId
  - widgetActionUrl, widgetLoginUrl
  - widgetIsLoggedIn, widgetGuestAllowed
  - widgetScale, widgetUserRating
  - widgetIcon, widgetEmojiIcon, widgetCustomSvg
  - fillPercent, emptyGlyph, filledGlyph
  - widgetHeadingTextRendered
  - widgetClickToRateTextRendered, widgetYourRatingTextRendered
#}
[data-engagement-rating] {
  text-align: center;
  font-family: inherit;
}

[data-engagement-rating] [data-rating-heading] {
  font-size: 13px;
  color: #475569;
  margin-bottom: 6px;
}

[data-engagement-rating] [data-rating-user] {
  font-size: 13px;
  color: #334155;
  min-height: 18px;
}

[data-engagement-rating] [data-rating-value]:focus-visible {
  outline: 2px solid #1d4ed8;
  outline-offset: 2px;
  border-radius: 4px;
  opacity: 1 !important;
  background: rgba(29, 78, 216, 0.14) !important;
}

[data-engagement-rating] .engagement-guest-message {
  display: inline-block;
  font-size: 13px;
  color: #334155;
  line-height: 1.4;
  padding: 8px 12px;
  border: 1px solid #d1d5db;
  border-radius: 8px;
  background: #f8fafc;
}

[data-engagement-rating] .engagement-guest-message a {
  color: #1d4ed8;
  text-decoration: underline;
}

[data-engagement-rating] .engagement-sr-only {
  position: absolute !important;
  width: 1px !important;
  height: 1px !important;
  padding: 0 !important;
  margin: -1px !important;
  overflow: hidden !important;
  clip: rect(0, 0, 0, 0) !important;
  white-space: nowrap !important;
  border: 0 !important;
}
