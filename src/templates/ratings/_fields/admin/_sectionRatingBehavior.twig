{% import '_includes/forms.twig' as forms %}
{% import 'engagement/_partials/helpTooltip.twig' as help %}

{% set ratingDocsUrl = 'https://www.jtdevelop.com/development/plugins/engagement/guest-and-user-interaction' %}
{% set guestInteractionDocsUrl = '/admin/settings/plugins/engagement' %}
{% set helpSource = {
    sourceUrl: ratingDocsUrl,
    sourceLabel: 'Ratings field settings docs'|t('engagement'),
} %}
{% set ratingHelp = {
    allowGuestRatings: 'Allows logged-out visitors to submit ratings for this field. When this is off, guests follow the global Guest Interaction Behavior from the [Engagement plugin settings]({url}), where you can choose whether blocked guests see a message or get redirected to login.'|t('engagement', {
        url: guestInteractionDocsUrl,
    }),
} %}

<details class="eng-disclosure">
  <summary>{{ 'Rating Behavior'|t('engagement') }}</summary>
  {{ forms.textField({
      label: 'Scale'|t('engagement'),
      instructions: 'Controls how many rating steps/icons are shown (for example, 5 means users can rate from 1 to 5). Must be between 1 and {max}.'|t('engagement', { max: maxScale }),
      id: 'scale',
      name: 'scale',
      type: 'number',
      min: 1,
      max: maxScale,
      value: field.scale ?: 5,
      required: true,
      errors: field.getErrors('scale'),
  }) }}

  {{ forms.lightswitchField({
      label: 'Default Enabled State'|t('engagement'),
      instructions: 'Whether the rating widget is shown by default on new entries.'|t('engagement'),
      id: 'defaultEnabled',
      name: 'defaultEnabled',
      on: field.defaultEnabled,
      errors: field.getErrors('defaultEnabled'),
  }) }}

  {{ forms.lightswitchField({
      label: 'Allow Guest Ratings'|t('engagement') ~ help.tooltip(ratingHelp.allowGuestRatings, helpSource),
      id: 'allowGuestRatings',
      name: 'allowGuestRatings',
      on: field.allowGuestRatings,
      errors: field.getErrors('allowGuestRatings'),
  }) }}

  {{ forms.lightswitchField({
      label: 'Allow Users to Change Their Rating'|t('engagement'),
      instructions: 'Whether visitors can update their rating after submitting one.'|t('engagement'),
      id: 'allowUserRatingChange',
      name: 'allowUserRatingChange',
      on: field.allowUserRatingChange,
      errors: field.getErrors('allowUserRatingChange'),
  }) }}
</details>
