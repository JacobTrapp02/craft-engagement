{# @var field \jtdev\craftengagement\fields\RatingField #}
{# @var maxScale int #}

{% import 'engagement/_partials/helpTooltip.twig' as help %}

{% set ratingDocsUrl = 'https://www.jtdevelop.com/development/plugins/engagement/ratings#field-settings' %}

{{ help.styles() }}

<p>
    {{ 'Need help setting up ratings? Visit the [Ratings documentation]({url}).'|t('engagement', {
        url: ratingDocsUrl,
    })|cpmd }}
</p>

{% include 'engagement/ratings/_fields/_widgetPreview.twig' with {
    title: 'Widget Preview'|t('engagement'),
    instructions: 'Live preview of how the widget will look before and after rating. Preview uses sample rating data.'|t('engagement'),
    elementId: 1,
    fieldId: 1,
    siteId: 1,
    label: field.name ?? 'Rating'|t('engagement'),
    icon: field.icon,
    emojiIcon: field.emojiIcon,
    customSvg: field.customSvg,
    scale: field.scale ?: 5,
    average: 3.75,
    voteCount: 42,
    headingText: field.headingText,
    clickToRateText: field.clickToRateText,
    yourRatingText: field.yourRatingText,
    afterUserRating: 4,
} only %}

{% include 'engagement/ratings/_fields/admin/_sectionIconAppearance.twig' with {
    field: field,
    iconOptions: iconOptions,
} only %}

{% include 'engagement/ratings/_fields/admin/_sectionRatingBehavior.twig' with {
    field: field,
    maxScale: maxScale,
} only %}

{% include 'engagement/ratings/_fields/admin/_sectionTextOverrides.twig' with {
    field: field,
} only %}

{% include 'engagement/ratings/_fields/admin/_sectionEditorOverrides.twig' with {
    field: field,
} only %}

{% include 'engagement/_partials/sharedFieldAssets.twig' %}
