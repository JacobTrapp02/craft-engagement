{% import '_includes/forms.twig' as forms %}

<details class="eng-disclosure">
  <summary>{{ 'Rating Behavior'|t('engagement') }}</summary>
  {% if canOverrideScale %}
    {{ forms.textField({
        label: 'Scale'|t('engagement'),
        instructions: 'Controls how many rating steps/icons are shown for this element (for example, 5 means users can rate from 1 to 5). Must be between 1 and {max}.'|t('engagement', { max: maxScale }),
        id: prefix ~ '-scale',
        name: prefix ~ '[scale]',
        type: 'number',
        min: 1,
        max: maxScale,
        value: rating.scale,
    }) }}
  {% endif %}

  {% if canOverrideGuests %}
    {{ forms.lightswitchField({
        label: 'Allow Guest Ratings'|t('engagement'),
        id: prefix ~ '-allow-guest-ratings',
        name: prefix ~ '[allowGuestRatings]',
        on: rating.allowGuestRatings,
    }) }}
  {% endif %}

  {% if canOverrideUserChange %}
    {{ forms.lightswitchField({
        label: 'Allow Users To Change Rating'|t('engagement'),
        id: prefix ~ '-allow-user-rating-change',
        name: prefix ~ '[allowUserRatingChange]',
        on: rating.allowUserRatingChange,
    }) }}
  {% endif %}
</details>
