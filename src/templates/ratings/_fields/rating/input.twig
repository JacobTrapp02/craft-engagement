{# @var field \jtdev\craftengagement\fields\RatingField #}
{# @var rating \jtdev\craftengagement\models\Rating #}
{# @var maxScale int #}

{% import '_includes/forms.twig' as forms %}

{% set prefix = field.handle %}
{% set canOverrideEnabled = field.allowEditorOverrides and field.allowOverrideWidgetEnabled %}
{% set canOverrideScale = field.allowEditorOverrides and field.allowOverrideScale %}
{% set canOverrideIcon = field.allowEditorOverrides and field.allowOverrideIconAppearance %}
{% set canOverrideGuests = field.allowEditorOverrides and field.allowOverrideGuestRatings %}
{% set canOverrideUserChange = field.allowEditorOverrides and field.allowOverrideUserRatingChange %}
{% set canOverrideText = field.allowEditorOverrides and (field.allowOverrideHeadingText or field.allowOverrideClickToRateText or field.allowOverrideYourRatingText) %}
{% set canShowWidgetPreview = field.allowEditorOverrides and field.allowOverrideWidgetPreview %}

<div class="eng-entry-settings" data-rating-entry-settings>
  <div class="eng-entry-title">
    {{ 'Rating Settings'|t('engagement') }}
  </div>

  <div class="readable eng-entry-aggregate">
    <div class="eng-entry-aggregate-value">
      {{ 'Average {average} / {scale} ({count} votes)'|t('engagement', {
        average: rating.roundedAverage,
        scale: rating.scale,
        count: rating.voteCount,
      }) }}
    </div>
  </div>

  {% if canOverrideEnabled %}
    {{ forms.lightswitchField({
        label: 'Enabled for This Element'|t('engagement'),
        instructions: 'Disable to hide rating interactions for this element.'|t('engagement'),
        id: prefix ~ '-enabled',
        name: prefix ~ '[enabled]',
        on: rating.enabled,
    }) }}
  {% endif %}

  {% if canShowWidgetPreview %}
    {% include 'engagement/ratings/_fields/rating/_widgetPreview.twig' with {
        title: 'Widget Preview'|t('engagement'),
        instructions: null,
        elementId: 1,
        fieldId: field.id ?? 1,
        siteId: craft.app.sites.currentSite.id,
        label: field.name ?? 'Rating'|t('engagement'),
        icon: rating.icon,
        emojiIcon: rating.emojiIcon,
        customSvg: rating.customSvg,
        scale: rating.scale,
        average: rating.roundedAverage ?: 0,
        voteCount: rating.voteCount ?: 0,
        headingText: rating.headingText,
        clickToRateText: rating.clickToRateText,
        yourRatingText: rating.yourRatingText,
        afterUserRating: rating.scale >= 4 ? 4 : rating.scale,
    } only %}
  {% endif %}

  {% if canOverrideIcon %}
    {% include 'engagement/ratings/_fields/rating/input/_sectionIconAppearance.twig' with {
        prefix: prefix,
        rating: rating,
        iconOptions: iconOptions,
    } only %}
  {% endif %}

  {% if canOverrideScale or canOverrideGuests or canOverrideUserChange %}
    {% include 'engagement/ratings/_fields/rating/input/_sectionRatingBehavior.twig' with {
        prefix: prefix,
        rating: rating,
        maxScale: maxScale,
        canOverrideScale: canOverrideScale,
        canOverrideGuests: canOverrideGuests,
        canOverrideUserChange: canOverrideUserChange,
    } only %}
  {% endif %}

  {% if canOverrideText %}
    {% include 'engagement/ratings/_fields/rating/input/_sectionTextOverrides.twig' with {
        prefix: prefix,
        field: field,
        rating: rating,
    } only %}
  {% endif %}
</div>

{% js %}
(() => {
  const roots = document.querySelectorAll('[data-rating-entry-settings]');
  roots.forEach((root) => {
    const panels = root.querySelectorAll('[data-entry-icon-mode-panel]');
    const select = root.querySelector('[data-entry-icon-mode-source="1"]');
    if (!(select instanceof HTMLSelectElement)) {
      return;
    }

    const syncPanels = () => {
      const mode = select.value;
      panels.forEach((panel) => {
        if (panel instanceof HTMLElement) {
          panel.style.display = panel.dataset.entryIconModePanel === mode ? '' : 'none';
        }
      });
    };

    select.addEventListener('change', syncPanels);
    syncPanels();
    requestAnimationFrame(syncPanels);
  });
})();
{% endjs %}

{% css %}
.eng-entry-settings {
  border: 1px solid #d6d9de;
  border-radius: 8px;
  background: #f7f8fa;
  padding: 14px;
}

.eng-entry-title {
  font-size: 12px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: #5c6b7a;
  margin-bottom: 8px;
}

.eng-entry-aggregate {
  margin-bottom: 12px;
  color: #3f4d5a;
}

.eng-entry-aggregate-value {
  font-weight: 600;
}

.eng-disclosure {
  margin: 12px 0;
  border: 1px solid #d6d9de;
  border-radius: 10px;
  background: #f9fafb;
  padding: 12px;
}

.eng-disclosure > summary {
  cursor: pointer;
  font-weight: 600;
  display: list-item;
  margin-bottom: 0;
}

.eng-disclosure[open] > summary {
  margin-bottom: 10px;
}

.eng-group-card {
  border: 1px solid #d6d9de;
  border-radius: 10px;
  background: #f9fafb;
  padding: 12px;
}

.eng-disclosure .eng-group-card {
  border: 0;
  background: transparent;
  padding: 0;
  margin-bottom: 0;
}

.eng-preview-grid {
  margin-top: 4px;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.eng-preview-col {
  border: 1px solid #e5e7eb;
  border-radius: 8px;
  background: #fff;
  padding: 10px;
}

.eng-preview-title {
  font-size: 12px;
  font-weight: 600;
  color: #64748b;
  margin-bottom: 8px;
}
{% endcss %}
