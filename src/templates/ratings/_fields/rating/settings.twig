{# @var field \jtdev\craftengagement\fields\RatingField #}
{# @var pluginSettings \jtdev\craftengagement\models\Settings #}

{% include 'engagement/ratings/_fields/rating/_widgetPreview.twig' with {
    title: 'Widget Preview'|t('engagement'),
    instructions: 'Live preview of how the widget will look before and after rating.'|t('engagement'),
    elementId: 1,
    fieldId: 1,
    siteId: 1,
    label: field.name ?? 'Rating'|t('engagement'),
    icon: field.icon,
    emojiIcon: field.emojiIcon,
    customSvg: field.customSvg,
    scale: field.scale ?: pluginSettings.defaultScale,
    average: 3.75,
    voteCount: 42,
    headingText: field.headingText,
    clickToRateText: field.clickToRateText,
    yourRatingText: field.yourRatingText,
    afterUserRating: 4,
} only %}

{% include 'engagement/ratings/_fields/rating/settings/_sectionIconAppearance.twig' with {
    field: field,
    pluginSettings: pluginSettings,
    iconOptions: iconOptions,
} only %}

{% include 'engagement/ratings/_fields/rating/settings/_sectionRatingBehavior.twig' with {
    field: field,
    pluginSettings: pluginSettings,
} only %}

{% include 'engagement/ratings/_fields/rating/settings/_sectionTextOverrides.twig' with {
    field: field,
} only %}

{% include 'engagement/ratings/_fields/rating/settings/_sectionEditorOverrides.twig' with {
    field: field,
} only %}

{% js %}
(() => {
  const panels = document.querySelectorAll('[data-icon-mode-panel]');
  const getIconSelect = () => document.querySelector('[data-icon-mode-source="1"]');

  const syncIconPanels = () => {
    const iconSelect = getIconSelect();
    if (!iconSelect) {
      return;
    }
    const mode = iconSelect.value;
    panels.forEach((panel) => {
      if (panel instanceof HTMLElement) {
        panel.style.display = panel.dataset.iconModePanel === mode ? '' : 'none';
      }
    });
  };

  document.addEventListener('change', (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement)) {
      return;
    }

    if (target.matches('[data-icon-mode-source="1"]')) {
      syncIconPanels();
    }
  });

  syncIconPanels();
  requestAnimationFrame(syncIconPanels);
})();
{% endjs %}

{% css %}
.eng-group-card {
  border: 1px solid #d6d9de;
  border-radius: 10px;
  background: #f9fafb;
  padding: 12px;
  margin-bottom: 14px;
}

.eng-disclosure {
  margin: 14px 0;
  border: 1px solid #d6d9de;
  border-radius: 10px;
  background: #f9fafb;
  padding: 12px;
}

.eng-disclosure > summary {
  cursor: pointer;
  font-weight: 600;
  display: list-item;
  margin-bottom: 0;
}

.eng-disclosure[open] > summary {
  margin-bottom: 10px;
}

.eng-disclosure .eng-group-card {
  border: 0;
  background: transparent;
  padding: 0;
  margin-bottom: 0;
}

.eng-editor-master {
  padding-bottom: 10px;
  margin-bottom: 10px;
  border-bottom: 1px solid #e5e7eb;
}

.eng-subgroup-card {
  border: 1px solid #e5e7eb !important;
  background: #fff !important;
  border-radius: 8px;
  padding: 12px;
}

.eng-disclosure .eng-subgroup-card {
  padding: 12px;
}

.eng-preview-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.eng-preview-col {
  border: 1px solid #e5e7eb;
  border-radius: 8px;
  background: #fff;
  padding: 10px;
}

.eng-preview-title {
  font-size: 12px;
  font-weight: 600;
  color: #64748b;
  margin-bottom: 8px;
}
{% endcss %}
