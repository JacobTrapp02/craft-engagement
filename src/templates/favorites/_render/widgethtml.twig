{#
  Favorites Widget HTML
  Available Twig variables:
  - widgetUid
  - widgetPreviewMode
  - widgetElementId, widgetFieldId, widgetSiteId
  - widgetActionUrl, widgetLoginUrl
  - widgetIsLoggedIn, widgetGuestAllowed
  - widgetIsFavorited, widgetFavoriteCount
  - widgetIcon, widgetEmojiIcon, widgetCustomSvg
  - widgetFavoriteBeforeBg, widgetFavoriteAfterBg
  - widgetHeadingText, widgetHeadingTextRendered
  - widgetFavoriteTextRendered, widgetUnfavoriteTextRendered
#}
<div
  data-engagement-favorite
  data-favorite-uid="{{ widgetUid }}"
  data-element-id="{{ widgetElementId|e('html_attr') }}"
  data-field-id="{{ widgetFieldId|e('html_attr') }}"
  data-site-id="{{ widgetSiteId|e('html_attr') }}"
  data-action-url="{{ widgetActionUrl|e('html_attr') }}"
  data-login-url="{{ widgetLoginUrl|e('html_attr') }}"
  data-is-logged-in="{{ widgetIsLoggedIn ? '1' : '0' }}"
  data-guest-allowed="{{ widgetGuestAllowed ? '1' : '0' }}"
>
  {% if widgetHeadingText %}
    <div data-favorite-heading>{{ widgetHeadingTextRendered }}</div>
  {% endif %}

  <button
    type="button"
    data-favorite-btn
    style="background:{{ widgetIsFavorited ? widgetFavoriteAfterBg : widgetFavoriteBeforeBg }}; {{ widgetPreviewMode ? 'cursor:default;' : 'cursor:pointer;' }}"
  >
    {% if widgetIcon != 'none' %}
      <span data-favorite-icon>
        {% if widgetIcon == 'emoji' %}
          {{ widgetEmojiIcon }}
        {% elseif widgetIcon == 'customSvg' and widgetCustomSvg %}
          <span class="engagement-favorite-svg-icon">{{ widgetCustomSvg|raw }}</span>
        {% elseif widgetIcon == 'star' %}
          {{ widgetIsFavorited ? '★' : '☆' }}
        {% else %}
          {{ widgetIsFavorited ? '♥' : '♡' }}
        {% endif %}
      </span>
    {% endif %}
    <span data-favorite-label>{{ widgetIsFavorited ? widgetUnfavoriteTextRendered : widgetFavoriteTextRendered }}</span>
  </button>
</div>
