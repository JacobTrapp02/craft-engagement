{#
  Favorites Widget CSS
  Rendered with `_context` from `favorites/_render/widget.twig`.
  Available Twig variables include:
  - widgetUid
  - widgetPreviewMode
  - widgetElementId, widgetFieldId, widgetSiteId
  - widgetActionUrl, widgetLoginUrl
  - widgetIsLoggedIn, widgetGuestAllowed
  - widgetIsFavorited, widgetFavoriteCount
  - widgetIcon, widgetEmojiIcon, widgetCustomSvg
  - widgetFavoriteBeforeBg, widgetFavoriteAfterBg
  - widgetHeadingText, widgetHeadingTextRendered
  - widgetFavoriteTextRendered, widgetUnfavoriteTextRendered
#}
[data-engagement-favorite] {
  text-align: center;
}

[data-engagement-favorite] [data-favorite-heading] {
  font-size: 13px;
  color: #475569;
  margin-bottom: 8px;
}

[data-engagement-favorite] [data-favorite-btn] {
  border: 1px solid #d1d5db;
  border-radius: 999px;
  padding: 6px 12px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  line-height: 1;
}

[data-engagement-favorite] [data-favorite-btn][data-has-label="0"] {
  width: 44px;
  height: 44px;
  padding: 0;
}

[data-engagement-favorite] [data-favorite-icon] {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 18px;
  height: 18px;
  flex: 0 0 18px;
}

[data-engagement-favorite] [data-favorite-label]:empty {
  display: none;
}

[data-engagement-favorite] .engagement-favorite-svg-icon {
  display: inline-flex;
  width: 16px;
  height: 16px;
  vertical-align: middle;
  align-items: center;
  justify-content: center;
}

[data-engagement-favorite] .engagement-favorite-svg-icon svg {
  display: block;
  width: 100%;
  height: 100%;
}

[data-engagement-favorite] .engagement-guest-message {
  display: inline-block;
  font-size: 13px;
  color: #334155;
  line-height: 1.4;
  padding: 8px 12px;
  border: 1px solid #d1d5db;
  border-radius: 8px;
  background: #f8fafc;
}

[data-engagement-favorite] .engagement-guest-message a {
  color: #1d4ed8;
  text-decoration: underline;
}
