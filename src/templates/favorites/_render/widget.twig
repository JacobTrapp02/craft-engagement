{% set widgetUid = random() %}
{% set widgetPreviewMode = previewMode ?? false %}
{% set widgetElementId = elementId ?? null %}
{% set widgetFieldId = fieldId ?? null %}
{% set widgetSiteId = siteId ?? craft.app.sites.currentSite.id %}
{% set widgetActionUrl = actionUrl ?? actionUrl('engagement/favorites/toggle-favorite') %}
{% set widgetLoginUrl = loginUrl ?? url('login') %}
{% set widgetIsLoggedIn = isLoggedIn ?? false %}
{% set widgetGuestAllowed = guestAllowed ?? false %}
{% set widgetIsFavorited = isFavorited ?? false %}
{% set widgetFavoriteCount = favoriteCount ?? 0 %}
{% set widgetIcon = icon ?? 'heart' %}
{% set widgetEmojiIcon = emojiIcon ?? '⭐' %}
{% set widgetBeforeFavoriteColor = beforeFavoriteColor ?? '' %}
{% set widgetAfterFavoriteColor = afterFavoriteColor ?? '' %}
{% set widgetFavoriteBeforeBg = widgetBeforeFavoriteColor ?: '#fff' %}
{% set widgetFavoriteAfterBg = widgetAfterFavoriteColor ?: '#fff' %}
{% set widgetCustomSvg = customSvg ?? null %}
{% set widgetHeadingText = headingText ?? '' %}
{% set widgetFavoriteText = favoriteText ?? '' %}
{% set widgetUnfavoriteText = unfavoriteText ?? '' %}
{% set tokenMap = {
  '{favorites}': widgetFavoriteCount,
  '{favoriteCount}': widgetFavoriteCount,
  '{fieldName}': label ?? '',
  '{elementId}': widgetElementId ?? '',
  '{isFavorited}': widgetIsFavorited ? 1 : 0,
} %}
{% set widgetHeadingTextRendered = widgetHeadingText is not empty ? widgetHeadingText|replace(tokenMap) : '' %}
{% set widgetFavoriteTextRendered = widgetFavoriteText is not empty ? widgetFavoriteText|replace(tokenMap) : '' %}
{% set widgetUnfavoriteTextRendered = widgetUnfavoriteText is not empty ? widgetUnfavoriteText|replace(tokenMap) : '' %}

{% if widgetElementId and widgetFieldId %}
  <div
    data-engagement-favorite
    data-favorite-uid="{{ widgetUid }}"
    data-element-id="{{ widgetElementId|e('html_attr') }}"
    data-field-id="{{ widgetFieldId|e('html_attr') }}"
    data-site-id="{{ widgetSiteId|e('html_attr') }}"
    data-action-url="{{ widgetActionUrl|e('html_attr') }}"
    data-login-url="{{ widgetLoginUrl|e('html_attr') }}"
    data-is-logged-in="{{ widgetIsLoggedIn ? '1' : '0' }}"
    data-guest-allowed="{{ widgetGuestAllowed ? '1' : '0' }}"
    style="text-align:center;"
  >
    {% if widgetHeadingText %}
      <div data-favorite-heading style="font-size:13px; color:#475569; margin-bottom:8px;">{{ widgetHeadingTextRendered }}</div>
    {% endif %}

    <button
      type="button"
      data-favorite-btn
      style="border:1px solid #d1d5db; border-radius:999px; padding:6px 12px; background:{{ widgetIsFavorited ? widgetFavoriteAfterBg : widgetFavoriteBeforeBg }}; {{ widgetPreviewMode ? 'cursor:default;' : 'cursor:pointer;' }}"
    >
      {% if widgetIcon != 'none' %}
        <span data-favorite-icon>
          {% if widgetIcon == 'emoji' %}
            {{ widgetEmojiIcon }}
          {% elseif widgetIcon == 'customSvg' and widgetCustomSvg %}
            <span style="display:inline-flex; width:16px; height:16px; vertical-align:middle;">{{ widgetCustomSvg|raw }}</span>
          {% elseif widgetIcon == 'star' %}
            {{ widgetIsFavorited ? '★' : '☆' }}
          {% else %}
            {{ widgetIsFavorited ? '♥' : '♡' }}
          {% endif %}
        </span>
      {% endif %}
      <span data-favorite-label>{{ widgetIsFavorited ? widgetUnfavoriteTextRendered : widgetFavoriteTextRendered }}</span>
    </button>
  </div>

  {% if not widgetPreviewMode %}
  <script>
  (() => {
    const root = document.querySelector('[data-engagement-favorite][data-favorite-uid="{{ widgetUid }}"]');
    if (!root) {
      return;
    }

    const button = root.querySelector('[data-favorite-btn]');
    const headingEl = root.querySelector('[data-favorite-heading]');
    const labelEl = root.querySelector('[data-favorite-label]');

    let isFavorited = {{ widgetIsFavorited ? 'true' : 'false' }};
    let favoriteCount = Number({{ widgetFavoriteCount }});
    const headingTemplate = {{ widgetHeadingText|json_encode|raw }};
    const favoriteText = {{ widgetFavoriteText|json_encode|raw }};
    const unfavoriteText = {{ widgetUnfavoriteText|json_encode|raw }};
    const beforeFavoriteColor = {{ widgetBeforeFavoriteColor|json_encode|raw }};
    const afterFavoriteColor = {{ widgetAfterFavoriteColor|json_encode|raw }};
    const fieldName = {{ (label ?? '')|json_encode|raw }};

    const actionUrl = root.getAttribute('data-action-url');
    const loginUrl = root.getAttribute('data-login-url') || '/login';
    const isLoggedIn = root.getAttribute('data-is-logged-in') === '1';
    const guestAllowed = root.getAttribute('data-guest-allowed') === '1';
    const elementId = Number(root.getAttribute('data-element-id'));
    const fieldId = Number(root.getAttribute('data-field-id'));
    const siteId = Number(root.getAttribute('data-site-id'));

    const formatText = (template) => {
      if (!template || !template.trim()) {
        return '';
      }

      const values = {
        favorites: favoriteCount,
        favoriteCount,
        fieldName,
        elementId,
        isFavorited: isFavorited ? 1 : 0,
      };

      return template.replace(/\{(favorites|favoriteCount|fieldName|elementId|isFavorited)\}/g, (_, token) => {
        const value = values[token];
        return value === null || value === undefined ? '' : String(value);
      });
    };

    const toRgb = (hex) => {
      if (!hex || typeof hex !== 'string') {
        return null;
      }
      const trimmed = hex.trim();
      if (/^#[0-9a-fA-F]{3}$/.test(trimmed)) {
        return {
          r: parseInt(trimmed[1] + trimmed[1], 16),
          g: parseInt(trimmed[2] + trimmed[2], 16),
          b: parseInt(trimmed[3] + trimmed[3], 16),
        };
      }
      if (/^#[0-9a-fA-F]{6}$/.test(trimmed)) {
        return {
          r: parseInt(trimmed.slice(1, 3), 16),
          g: parseInt(trimmed.slice(3, 5), 16),
          b: parseInt(trimmed.slice(5, 7), 16),
        };
      }
      return null;
    };

    const contrastTextColor = (background) => {
      const rgb = toRgb(background);
      if (!rgb) {
        return '';
      }
      const luminance = (0.299 * rgb.r) + (0.587 * rgb.g) + (0.114 * rgb.b);
      return luminance < 140 ? '#fff' : '#000';
    };

    const refreshState = () => {
      if (headingEl) {
        const heading = formatText(headingTemplate);
        headingEl.textContent = heading;
        headingEl.style.display = heading ? '' : 'none';
      }
      if (labelEl) {
        labelEl.textContent = isFavorited ? formatText(unfavoriteText) : formatText(favoriteText);
      }
      if (button instanceof HTMLElement) {
        const favoriteBg = isFavorited ? (afterFavoriteColor || '#fff') : (beforeFavoriteColor || '#fff');
        button.style.background = favoriteBg;
        button.style.color = contrastTextColor(favoriteBg);
      }
    };

    button?.addEventListener('click', async () => {
      if (!isLoggedIn && !guestAllowed) {
        const goLogin = window.confirm({{ 'Please log in to interact.'|t('engagement')|json_encode|raw }});
        if (goLogin) {
          window.location.href = loginUrl;
        }
        return;
      }

      if (!actionUrl || !elementId || !fieldId) {
        return;
      }

      try {
        const response = await fetch(actionUrl, {
          method: 'POST',
          credentials: 'same-origin',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json',
            'X-CSRF-Token': {{ craft.app.request.csrfToken|json_encode|raw }},
          },
          body: JSON.stringify({ elementId, fieldId, siteId }),
        });

        if (!response.ok) {
          return;
        }

        const data = await response.json();
        isFavorited = Boolean(data?.entry?.isFavorited ?? false);
        favoriteCount = Number(data?.aggregate?.favoriteCount ?? favoriteCount);
        refreshState();
      } catch (e) {
      }
    });

    refreshState();
  })();
  </script>
  {% endif %}
{% endif %}
