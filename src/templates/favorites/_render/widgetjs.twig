{#
  Favorites Widget JS
  Rendered with `_context` from `favorites/_render/widget.twig`.
  Available Twig variables include:
  - widgetUid
  - widgetPreviewMode
  - widgetElementId, widgetFieldId, widgetSiteId
  - widgetActionUrl, widgetLoginUrl, widgetRegisterUrl
  - widgetIsLoggedIn, widgetGuestAllowed
  - widgetIsFavorited, widgetFavoriteCount
  - widgetHeadingText, widgetFavoriteText, widgetUnfavoriteText
  - widgetBeforeFavoriteColor, widgetAfterFavoriteColor
  - label
  - craft.app.request.csrfToken
#}
(() => {
  const root = document.querySelector('[data-engagement-favorite][data-favorite-uid="{{ widgetUid }}"]');
  if (!root) {
    return;
  }

  const button = root.querySelector('[data-favorite-btn]');
  const headingEl = root.querySelector('[data-favorite-heading]');
  const labelEl = root.querySelector('[data-favorite-label]');

  let isFavorited = {{ widgetIsFavorited ? 'true' : 'false' }};
  let favoriteCount = Number({{ widgetFavoriteCount }});
  const headingTemplate = {{ widgetHeadingText|json_encode|raw }};
  const favoriteText = {{ widgetFavoriteText|json_encode|raw }};
  const unfavoriteText = {{ widgetUnfavoriteText|json_encode|raw }};
  const beforeFavoriteColor = {{ widgetBeforeFavoriteColor|json_encode|raw }};
  const afterFavoriteColor = {{ widgetAfterFavoriteColor|json_encode|raw }};
  const fieldName = {{ (label ?? '')|json_encode|raw }};

  const actionUrl = root.getAttribute('data-action-url');
  const loginUrl = root.getAttribute('data-login-url') || '/login';
  const registerUrl = root.getAttribute('data-register-url') || '';
  const isLoggedIn = root.getAttribute('data-is-logged-in') === '1';
  const guestAllowed = root.getAttribute('data-guest-allowed') === '1';
  const elementId = Number(root.getAttribute('data-element-id'));
  const fieldId = Number(root.getAttribute('data-field-id'));
  const siteId = Number(root.getAttribute('data-site-id'));

  const formatText = (template) => {
    if (!template || !template.trim()) {
      return '';
    }

    const values = {
      favorites: favoriteCount,
      favoriteCount,
      fieldName,
      elementId,
      isFavorited: isFavorited ? 1 : 0,
    };

    return template.replace(/\{(favorites|favoriteCount|fieldName|elementId|isFavorited)\}/g, (_, token) => {
      const value = values[token];
      return value === null || value === undefined ? '' : String(value);
    });
  };

  const toRgb = (hex) => {
    if (!hex || typeof hex !== 'string') {
      return null;
    }
    const trimmed = hex.trim();
    if (/^#[0-9a-fA-F]{3}$/.test(trimmed)) {
      return {
        r: parseInt(trimmed[1] + trimmed[1], 16),
        g: parseInt(trimmed[2] + trimmed[2], 16),
        b: parseInt(trimmed[3] + trimmed[3], 16),
      };
    }
    if (/^#[0-9a-fA-F]{6}$/.test(trimmed)) {
      return {
        r: parseInt(trimmed.slice(1, 3), 16),
        g: parseInt(trimmed.slice(3, 5), 16),
        b: parseInt(trimmed.slice(5, 7), 16),
      };
    }
    return null;
  };

  const contrastTextColor = (background) => {
    const rgb = toRgb(background);
    if (!rgb) {
      return '';
    }
    const luminance = (0.299 * rgb.r) + (0.587 * rgb.g) + (0.114 * rgb.b);
    return luminance < 140 ? '#fff' : '#000';
  };

  const refreshState = () => {
    if (headingEl) {
      const heading = formatText(headingTemplate);
      headingEl.textContent = heading;
      headingEl.style.display = heading ? '' : 'none';
    }
    if (labelEl) {
      labelEl.textContent = isFavorited ? formatText(unfavoriteText) : formatText(favoriteText);
    }
    if (button instanceof HTMLElement) {
      const favoriteBg = isFavorited ? (afterFavoriteColor || '#fff') : (beforeFavoriteColor || '#fff');
      button.style.background = favoriteBg;
      button.style.color = contrastTextColor(favoriteBg);
    }
  };

  button?.addEventListener('click', async () => {
    if (!isLoggedIn && !guestAllowed) {
      const goLogin = window.confirm(registerUrl
        ? {{ 'Please log in to interact. Click OK to log in or Cancel to register.'|t('engagement')|json_encode|raw }}
        : {{ 'Please log in to interact.'|t('engagement')|json_encode|raw }});
      if (goLogin) {
        window.location.href = loginUrl;
      } else if (registerUrl) {
        window.location.href = registerUrl;
      }
      return;
    }

    if (!actionUrl || !elementId || !fieldId) {
      return;
    }

    try {
      const response = await fetch(actionUrl, {
        method: 'POST',
        credentials: 'same-origin',
        headers: {
          'Content-Type': 'application/json',
          Accept: 'application/json',
          'X-CSRF-Token': {{ craft.app.request.csrfToken|json_encode|raw }},
        },
        body: JSON.stringify({ elementId, fieldId, siteId }),
      });

      if (!response.ok) {
        return;
      }

      const data = await response.json();
      isFavorited = Boolean(data?.entry?.isFavorited ?? false);
      favoriteCount = Number(data?.aggregate?.favoriteCount ?? favoriteCount);
      refreshState();
    } catch (e) {
    }
  });

  refreshState();
})();
