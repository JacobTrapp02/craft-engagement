{% import '_includes/forms.twig' as forms %}
{% import 'engagement/_partials/helpTooltip.twig' as help %}

{% set favoritesDocsUrl = 'https://www.jtdevelop.com/development/plugins/engagement/favorites#favorites-field-settings' %}
{% set helpSource = {
    sourceUrl: favoritesDocsUrl,
    sourceLabel: 'Favorites field settings docs'|t('engagement'),
} %}
{% set iconHelp = {
    iconMode: 'Chooses the visual style used for the favorite button. Native icons use the built-in heart or star options. Emoji uses the selected emoji. Custom SVG uses your SVG markup. The color fields below control the button state before and after an item is favorited.'|t('engagement'),
} %}

{% set hasIconAppearanceErrors =
  field.getErrors('icon')|length
  or field.getErrors('emojiIcon')|length
  or field.getErrors('customSvg')|length
  or field.getErrors('beforeFavoriteColor')|length
  or field.getErrors('afterFavoriteColor')|length
%}

<details class="eng-disclosure" {% if hasIconAppearanceErrors %}open{% endif %}>
  <summary>{{ 'Icon Appearance'|t('engagement') }}</summary>
  <div class="field eng-group-card">
    <div class="instructions"><p>{{ 'Set icon colors before and after favoriting.'|t('engagement') }}</p></div>
    {{ forms.selectField({
        label: 'Icon Mode'|t('engagement') ~ help.tooltip(iconHelp.iconMode, helpSource),
        id: 'icon',
        name: 'icon',
        options: iconOptions,
        value: field.icon,
        errors: field.getErrors('icon'),
        inputAttributes: {
            'data-icon-mode-source': '1',
        },
    }) }}

    <div data-icon-mode-panel="emoji" style="{{ field.icon == 'emoji' ? '' : 'display:none;' }}">
      {% include 'engagement/_partials/emojiPicker.twig' with {
          label: 'Emoji Icon'|t('engagement'),
          inputId: 'emojiIcon',
          inputName: 'emojiIcon',
          inputValue: field.emojiIcon,
          errors: field.getErrors('emojiIcon'),
      } only %}
    </div>

    <div data-icon-mode-panel="customSvg" style="{{ field.icon == 'customSvg' ? '' : 'display:none;' }}">
      {{ forms.textareaField({ label: 'Custom SVG Markup'|t('engagement'), id: 'customSvg', name: 'customSvg', value: field.customSvg, errors: field.getErrors('customSvg'), rows: 6 }) }}
    </div>

    <div style="margin-top:10px;">
      {% include 'engagement/_partials/colorFieldWithPicker.twig' with {
          label: 'Before Favorite Color'|t('engagement'),
          id: 'beforeFavoriteColor',
          name: 'beforeFavoriteColor',
          value: field.beforeFavoriteColor,
          errors: field.getErrors('beforeFavoriteColor'),
          defaultColor: '#64748b',
      } only %}

      {% include 'engagement/_partials/colorFieldWithPicker.twig' with {
          label: 'After Favorite Color'|t('engagement'),
          id: 'afterFavoriteColor',
          name: 'afterFavoriteColor',
          value: field.afterFavoriteColor,
          errors: field.getErrors('afterFavoriteColor'),
          defaultColor: '#dc2626',
      } only %}
    </div>
  </div>
</details>
