{% import '_includes/forms.twig' as forms %}

<details class="eng-disclosure">
  <summary>{{ 'Text Overrides'|t('engagement') }}</summary>
  <div class="field eng-group-card">
    <div class="instructions"><p>{{ 'Optional. Supports tokens: {favorites}, {favoriteCount}, {fieldName}, {elementId}, {isFavorited}.'|t('engagement') }}</p></div>
    {% if field.allowOverrideHeadingText %}
      {{ forms.textField({ label: 'Text Above Widget'|t('engagement'), id: prefix ~ '-heading-text', name: prefix ~ '[headingText]', value: favorite.headingText }) }}
    {% endif %}

    {% if field.allowOverrideFavoriteText %}
      {{ forms.textField({ label: 'Favorite Button Text'|t('engagement'), id: prefix ~ '-favorite-text', name: prefix ~ '[favoriteText]', value: favorite.favoriteText }) }}
    {% endif %}

    {% if field.allowOverrideUnfavoriteText %}
      {{ forms.textField({ label: 'Unfavorite Button Text'|t('engagement'), id: prefix ~ '-unfavorite-text', name: prefix ~ '[unfavoriteText]', value: favorite.unfavoriteText }) }}
    {% endif %}
  </div>
</details>
