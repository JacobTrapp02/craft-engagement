{# @var field \jtdev\craftengagement\fields\FavoritesField #}
{# @var favorite \jtdev\craftengagement\models\Favorite #}

{% import '_includes/forms.twig' as forms %}

{% set prefix = field.handle %}
{% set canOverrideEnabled = field.allowEditorOverrides and field.allowOverrideWidgetEnabled %}
{% set canOverrideIcon = field.allowEditorOverrides and field.allowOverrideIconAppearance %}
{% set canOverrideColors = field.allowEditorOverrides and field.allowOverrideIconColors %}
{% set canOverrideGuests = field.allowEditorOverrides and field.allowOverrideGuestInteractions %}
{% set canOverrideText = field.allowEditorOverrides and (field.allowOverrideHeadingText or field.allowOverrideFavoriteText or field.allowOverrideUnfavoriteText) %}
{% set canShowWidgetPreview = field.allowEditorOverrides and field.allowOverrideWidgetPreview %}

<div class="eng-entry-settings" data-favorite-entry-settings>
  <div class="eng-entry-title">{{ 'Favorites Settings'|t('engagement') }}</div>

  <div class="readable eng-entry-aggregate">
    <div class="eng-entry-aggregate-value">
      {{ 'Favorites {count}'|t('engagement', { count: favorite.favoriteCount }) }}
    </div>
  </div>

  {% if canOverrideEnabled %}
    {{ forms.lightswitchField({ label: 'Enabled for This Element'|t('engagement'), id: prefix ~ '-enabled', name: prefix ~ '[enabled]', on: favorite.enabled }) }}
  {% endif %}

  {% if canShowWidgetPreview %}
    {% include 'engagement/favorites/_fields/favorite/_widgetPreview.twig' with {
        title: 'Widget Preview'|t('engagement'),
        instructions: null,
        elementId: 1,
        fieldId: field.id ?? 1,
        siteId: craft.app.sites.currentSite.id,
        label: field.name ?? 'Favorites'|t('engagement'),
        icon: favorite.icon,
        emojiIcon: favorite.emojiIcon,
        beforeFavoriteColor: favorite.beforeFavoriteColor,
        afterFavoriteColor: favorite.afterFavoriteColor,
        customSvg: favorite.customSvg,
        favoriteCount: favorite.favoriteCount ?: 0,
        headingText: favorite.headingText,
        favoriteText: favorite.favoriteText,
        unfavoriteText: favorite.unfavoriteText,
    } only %}
  {% endif %}

  {% if canOverrideIcon or canOverrideColors %}
    {% include 'engagement/favorites/_fields/favorite/input/_sectionIconAppearance.twig' with {
        prefix: prefix,
        favorite: favorite,
        iconOptions: iconOptions,
        canOverrideIcon: canOverrideIcon,
        canOverrideColors: canOverrideColors,
    } only %}
  {% endif %}

  {% if canOverrideGuests %}
    {% include 'engagement/favorites/_fields/favorite/input/_sectionBehavior.twig' with {
        prefix: prefix,
        favorite: favorite,
        canOverrideGuests: canOverrideGuests,
    } only %}
  {% endif %}

  {% if canOverrideText %}
    {% include 'engagement/favorites/_fields/favorite/input/_sectionTextOverrides.twig' with {
        prefix: prefix,
        field: field,
        favorite: favorite,
    } only %}
  {% endif %}
</div>

{% js %}
(() => {
  const roots = document.querySelectorAll('[data-favorite-entry-settings]');
  const toSixDigitHex = (value) => {
    if (typeof value !== 'string') {
      return null;
    }
    const trimmed = value.trim();
    if (/^#[0-9a-fA-F]{6}$/.test(trimmed)) {
      return trimmed.toLowerCase();
    }
    if (/^#[0-9a-fA-F]{3}$/.test(trimmed)) {
      const r = trimmed[1];
      const g = trimmed[2];
      const b = trimmed[3];
      return `#${r}${r}${g}${g}${b}${b}`.toLowerCase();
    }
    return null;
  };

  roots.forEach((root) => {
    const panels = root.querySelectorAll('[data-entry-icon-mode-panel]');
    const select = root.querySelector('[data-entry-icon-mode-source="1"]');
    const colorPairs = root.querySelectorAll('.eng-color-pair');
    if (!(select instanceof HTMLSelectElement)) {
      // Continue to color picker sync even when icon override select is hidden.
    }

    const syncPanels = () => {
      if (!(select instanceof HTMLSelectElement)) {
        return;
      }
      const mode = select.value;
      panels.forEach((panel) => {
        if (panel instanceof HTMLElement) {
          panel.style.display = panel.dataset.entryIconModePanel === mode ? '' : 'none';
        }
      });
    };

    const syncColorPairs = () => {
      colorPairs.forEach((pair) => {
        if (!(pair instanceof HTMLElement)) {
          return;
        }
        const picker = pair.querySelector('[data-eng-color-picker="1"]');
        const textInput = pair.querySelector('[data-eng-color-text="1"]');
        if (!(picker instanceof HTMLInputElement) || !(textInput instanceof HTMLInputElement)) {
          return;
        }

        if (picker.dataset.engColorBound === '1') {
          return;
        }
        picker.dataset.engColorBound = '1';

        const setPickerFromText = () => {
          const normalized = toSixDigitHex(textInput.value);
          if (normalized) {
            picker.value = normalized;
          }
        };

        picker.addEventListener('input', () => {
          textInput.value = picker.value;
        });
        textInput.addEventListener('input', setPickerFromText);
        setPickerFromText();
      });
    };

    if (select instanceof HTMLSelectElement) {
      select.addEventListener('change', syncPanels);
    }
    syncPanels();
    syncColorPairs();
    requestAnimationFrame(syncPanels);
    requestAnimationFrame(syncColorPairs);
  });
})();
{% endjs %}

{% css %}
.eng-entry-settings {
  border: 1px solid #d6d9de;
  border-radius: 8px;
  background: #f7f8fa;
  padding: 14px;
}

.eng-entry-title {
  font-size: 12px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: #5c6b7a;
  margin-bottom: 8px;
}

.eng-entry-aggregate {
  margin-bottom: 12px;
  color: #3f4d5a;
}

.eng-entry-aggregate-value {
  font-weight: 600;
}

.eng-disclosure {
  margin: 12px 0;
  border: 1px solid #d6d9de;
  border-radius: 10px;
  background: #f9fafb;
  padding: 12px;
}

.eng-disclosure > summary {
  cursor: pointer;
  font-weight: 600;
  display: list-item;
  margin-bottom: 0;
}

.eng-disclosure[open] > summary {
  margin-bottom: 10px;
}

.eng-group-card {
  border: 1px solid #d6d9de;
  border-radius: 10px;
  background: #f9fafb;
  padding: 12px;
}

.eng-disclosure .eng-group-card {
  border: 0;
  background: transparent;
  padding: 0;
  margin-bottom: 0;
}

.eng-preview-grid {
  margin-top: 4px;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.eng-preview-col {
  border: 1px solid #e5e7eb;
  border-radius: 8px;
  background: #fff;
  padding: 10px;
}

.eng-preview-title {
  font-size: 12px;
  font-weight: 600;
  color: #64748b;
  margin-bottom: 8px;
}
{% endcss %}
